# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# Authentication
# =============================================================================
# AUTH_PROVIDER: "clerk" (recommended) or "legacy".
#   clerk  -> Clerk is the identity provider; legacy auth endpoints are disabled.
#   legacy -> the previous custom JWT/OTP auth (kept for rollback/migration).
# If unset, it auto-detects: clerk when CLERK_SECRET_KEY is present, else legacy.
AUTH_PROVIDER="legacy"

# --- Clerk: SERVER-ONLY SECRET. NEVER prefix with VITE_ or expose to the client. ---
CLERK_SECRET_KEY=""
# Optional hardening: comma-separated origins allowed as the token `azp` claim.
CLERK_AUTHORIZED_PARTY=""
# Optional defense-in-depth: comma-separated Clerk user ids that may be admin.
ADMIN_CLERK_IDS=""

# --- Legacy auth secrets (only used when AUTH_PROVIDER=legacy) ---
AUTH_SECRET="rolling-razors-kenya-customs-secret-key-2026"
ADMIN_EMAIL="james@rollingrazors.co.ke"
ADMIN_PHONE="0712345678"
ADMIN_PASSWORD="rolling2025"
ADMIN_NAME="James Kimani"

# Safaricom Daraja Lipa Na M-Pesa Online Integration
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE="174379"
MPESA_ENVIRONMENT="sandbox"

# Server & Security
PORT="3000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
LOG_LEVEL="info"
ADMIN_NAME="James Kimani"

# Postgres (Docker Compose default)
DATABASE_URL="postgresql://rolling_razors:rolling_razors_pass@localhost:5435/rolling_razors"

# Sentry (optional)
SENTRY_DSN=""
VITE_SENTRY_DSN=""
SENTRY_ENV="production"

# Image CDN (optional)
IMAGE_CDN_URL=""
VITE_IMAGE_CDN_URL=""

# Admin isolation (optional, Casbin pending)
ADMIN_IP_ALLOWLIST=""
ADMIN_REQUIRE_2FA="false"
MPESA_CALLBACK_SECRET=""

# =============================================================================
# Client-safe Vite variables (bundled into the frontend — must use VITE_ prefix)
# =============================================================================
# Clerk publishable key. Safe to expose; it is NOT a secret.
VITE_CLERK_PUBLISHABLE_KEY=""
# Optional frontend override: "clerk" | "legacy" (defaults to auto-detect from the key).
VITE_AUTH_PROVIDER=""
VITE_GA_MEASUREMENT_ID=
