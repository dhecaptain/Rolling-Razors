# Rolling Razors Customs — example environment configuration
# Copy to .env and fill in real values. Never commit .env with secrets.
# See docs/ADMIN_BOOTSTRAP.md for the owner bootstrap flow.

# --- Runtime ---
NODE_ENV=development
PORT=3000
APP_URL=https://rollingrazors.co.ke
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# "mock" (JSON file in data/) for local/dev; "postgres" for production.
DATABASE_ENGINE=mock
DATABASE_URL=postgresql://rolling_razors:rolling_razors_pass@localhost:5435/rolling_razors
# "require" | "disable" (auto-detected as require for neon.tech hosts)
DATABASE_SSL=

# --- Auth provider: "legacy" (built-in JWT + bcrypt) or "clerk" ---
AUTH_PROVIDER=legacy
# Generate a unique 32+ byte JWT signing secret for legacy mode: openssl rand -hex 32
AUTH_SECRET=

# Clerk (only when AUTH_PROVIDER=clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional defense-in-depth: allow these Clerk user ids to be owner
ADMIN_CLERK_IDS=

# --- Legacy admin bootstrap ---
# One-time secret guarding POST /api/admin/bootstrap. Generate with:
#   openssl rand -hex 24
# The bootstrap endpoint is disabled when this is empty (production warns).
BOOTSTRAP_TOKEN=
# In production ADMIN_PASSWORD must be a bcrypt hash ($2a$/$2b$/$2y$), e.g.
#   htpasswd -bnBC 12 "" "your-password" | tr -d ':\n'
ADMIN_EMAIL=owner@example.test
ADMIN_PASSWORD=
# Plaintext initial owner password for prisma db:seed only; 16+ random characters.
SEED_ADMIN_PASSWORD=
# Optional IP allowlist for /api/admin/* (comma-separated) — empty = all
ADMIN_IP_ALLOWLIST=

# --- M-Pesa (Daraja) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_SECRET=

# --- Paystack (KES card / bank deposits) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_ENVIRONMENT=test
PAYSTACK_WEBHOOK_SECRET=

# --- Rate limiting ---
# "memory" (local/tests) | "upstash" (distributed on Vercel)
RATE_LIMIT_STORE=memory
RATE_LIMIT_GENERAL_MAX=10000
RATE_LIMIT_AUTH_MAX=1000
RATE_LIMIT_ADMIN_MAX=1000
RATE_LIMIT_MPESA_MAX=1000
RATE_LIMIT_PAYSTACK_MAX=1000

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_ENV=development

# --- Image storage ---
IMAGE_CDN=unsplash
# STORAGE_PROVIDER: "auto" | "local" | "cloudinary" | "supabase"
# "auto" picks Cloudinary when its keys are present, else Supabase, else Local.
# Local filesystem is fine for dev/tests but does NOT persist on serverless
# (Vercel) hosting — configure Cloudinary or Supabase for production uploads.
STORAGE_PROVIDER=auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rolling-razors
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=rolling-razors

# --- Frontend assets ---
# "placeholder" (default) renders safe gradient placeholders and lets the build
# pass without photos. Flip to "local" once public/images/hero/hero-01..03.jpg
# and public/images/materials/material-01..04.jpg exist — the build then
# verifies them (scripts/verify-assets.ts) and fails on any missing slot.
VITE_ASSET_MODE=placeholder