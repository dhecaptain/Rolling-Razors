      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .rr-page { font-family: 'Plus Jakarta Sans', sans-serif; background: #073B32; color: #F5F1E8; }\n  .rr-page button, .rr-page a, .rr-page input, .rr-page select { font: inherit; }\n  .rr-page button:focus-visible, .rr-page a:focus-visible, .rr-page input:focus-visible, .rr-page select:focus-visible, .rr-slider:focus-visible { outline: 2px solid #D6A62E; outline-offset: 3px; }\n  .rr-signature { font-family: 'Caveat', cursive; }\n  .rr-tabular { font-variant-numeric: tabular-nums; }\n  .rr-stitch { border-top: 1px dashed rgba(214,166,46,.68); position: relative; }\n  .rr-stitch:after { content: '◆'; position: absolute; right: 0; top: -11px; color: #D6A62E; font-size: 10px; background: #073B32; padding-left: 8px; }\n  .rr-paper .rr-stitch:after { background: #F5F1E8; }\n  .rr-service-row { border-bottom: 1px solid rgba(7,59,50,.18); min-height: 43px; }\n  .rr-service-row.is-active { background: #073B32; color: #F5F1E8; }\n  .rr-service-row.is-active .rr-service-meta { color: #D6A62E; }\n  .rr-service-row:hover { background: rgba(7,59,50,.08); }\n  .rr-service-row.is-active:hover { background: #073B32; }\n  .rr-swatch { min-height: 46px; }\n  .rr-swatch.is-active, .rr-material.is-active, .rr-pattern.is-active { border-color: #D6A62E !important; background: rgba(214,166,46,.08); }\n  .rr-filter.is-active { color: #073B32; border-bottom-color: #D6A62E; }\n  .rr-filter { border-bottom: 2px solid transparent; }\n  .rr-filter:hover { border-bottom-color: rgba(214,166,46,.55); color: #073B32; }\n  .rr-contact-table tr + tr { border-top: 1px solid rgba(245,241,232,.16); }\n  .rr-quality-row + .rr-quality-row { border-top: 1px solid rgba(7,59,50,.18); }\n  .rr-photo-caption { border-top: 1px solid rgba(7,59,50,.22); }\n  .rr-noise { background-image: none; }\n  .rr-map { background-color: #052822; background-image: linear-gradient(rgba(245,241,232,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(245,241,232,.06) 1px, transparent 1px), linear-gradient(155deg, transparent 48%, rgba(214,166,46,.32) 49%, rgba(214,166,46,.32) 50%, transparent 51%); background-size: 44px 44px, 44px 44px, 100% 100%; }\n  .rr-map iframe { filter: saturate(.75) contrast(.95); }\n  @media (max-width: 900px) {\n    .rr-nav-links { display: none; }\n    .rr-hero-grid, .rr-board-grid, .rr-spec-grid, .rr-arrival-grid { grid-template-columns: 1fr !important; }\n    .rr-hero-copy { min-height: 430px; }\n    .rr-service-list { max-height: none !important; }\n    .rr-service-index { grid-template-columns: 1fr 1fr !important; }\n    .rr-route { grid-template-columns: 1fr !important; }\n    .rr-route-line { left: 15px !important; top: 18px !important; bottom: 18px !important; }\n    .rr-route-step { padding-left: 48px !important; }\n    .rr-portfolio-grid { grid-template-columns: 1fr 1fr !important; }\n    .rr-footer-grid { grid-template-columns: 1fr 1fr !important; }\n  }\n  @media (max-width: 560px) {\n    .rr-page h1 { font-size: 2.65rem !important; }\n    .rr-page h2 { font-size: 2.15rem !important; }\n    .rr-service-index, .rr-portfolio-grid, .rr-footer-grid { grid-template-columns: 1fr !important; }\n    .rr-form-two { grid-template-columns: 1fr !important; }\n    .rr-vehicle-grid { grid-template-columns: repeat(3, minmax(0,1fr)) !important; }\n  }\n</style>\n<div class=\"rr-page min-h-screen overflow-x-hidden\" data-kid=\"1\">\n    <header class=\"h-[78px] bg-[#052822] border-b border-[#D6A62E]/25 sticky top-0 z-40\" data-kid=\"1-1\">\n        <div class=\"max-w-[1280px] mx-auto h-full px-5 lg:px-10 flex items-center justify-between gap-8\" data-kid=\"1-1-1\">\n            <a aria-label=\"Rolling Razors Customs home\" class=\"flex items-center gap-3 shrink-0\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span class=\"w-10 h-10 border border-[#D6A62E]/70 bg-[#073B32] grid place-items-center relative\" data-kid=\"1-1-1-1-1\">\n                    <svg aria-hidden=\"true\" class=\"w-7 h-7\" data-kid=\"1-1-1-1-1-1\" fill=\"none\" viewbox=\"0 0 40 40\">\n                        <rect height=\"34\" opacity=\".75\" rx=\"3\" stroke=\"#D6A62E\" stroke-width=\"1.3\" width=\"34\" x=\"3\" y=\"3\">\n                        </rect>\n                        <circle cx=\"13\" cy=\"28\" r=\"3.5\" stroke=\"#D6A62E\" stroke-width=\"1.6\">\n                        </circle>\n                        <path d=\"M15.5 25.5 27 11\" stroke=\"#D6A62E\" stroke-linecap=\"round\" stroke-width=\"2\">\n                        </path>\n                        <circle cx=\"27\" cy=\"28\" r=\"3.5\" stroke=\"#D6A62E\" stroke-width=\"1.6\">\n                        </circle>\n                        <path d=\"M24.5 25.5 13 11\" stroke=\"#D6A62E\" stroke-linecap=\"round\" stroke-width=\"2\">\n                        </path>\n                        <path d=\"M10 13c4-5 16-5 20 0\" stroke=\"#F5F1E8\" stroke-dasharray=\"2 2\" stroke-width=\"1\">\n                        </path>\n                        <path d=\"m20 16 3 4-3 4-3-4 3-4Z\" fill=\"#D6A62E\">\n                        </path>\n                    </svg>\n                </span>\n                <span class=\"leading-none\" data-kid=\"1-1-1-1-2\">\n                    <span class=\"block text-[#F5F1E8] font-black tracking-[-.04em] text-[17px] sm:text-[19px]\" data-kid=\"1-1-1-1-2-1\">\n                        ROLLING RAZORS\n                        <b class=\"text-[#D6A62E] text-[10px] sm:text-[11px] tracking-[.15em]\" data-kid=\"1-1-1-1-2-1-1\">\n                            CUSTOMS\n                        </b>\n                    </span>\n                    <span class=\"rr-signature block text-[#D6A62E] text-[13px] mt-1\" data-kid=\"1-1-1-1-2-2\">\n                        Your Vision, Our Craftsmanship.\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"rr-nav-links flex items-center gap-6 text-[12px] font-semibold text-[#F5F1E8]/75\" data-kid=\"1-1-1-2\">\n                <a class=\"hover:text-[#D6A62E]\" data-kid=\"1-1-1-2-1\" href=\"#services-section\">\n                    Services\n                </a>\n                <a class=\"hover:text-[#D6A62E]\" data-kid=\"1-1-1-2-2\" href=\"#spec-section\">\n                    Build spec\n                </a>\n                <a class=\"hover:text-[#D6A62E]\" data-kid=\"1-1-1-2-3\" href=\"#booking-route\">\n                    How it works\n                </a>\n                <a class=\"hover:text-[#D6A62E]\" data-kid=\"1-1-1-2-4\" href=\"#portfolio-section\">\n                    Our work\n                </a>\n                <a class=\"hover:text-[#D6A62E]\" data-kid=\"1-1-1-2-5\" href=\"#arrival-section\">\n                    Workshop\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2 shrink-0\" data-kid=\"1-1-1-3\">\n                <button class=\"hidden md:inline-flex items-center gap-2 h-10 px-4 border border-[#F5F1E8]/25 text-[#F5F1E8] text-[11px] font-bold hover:border-[#D6A62E] hover:text-[#D6A62E]\" data-kid=\"1-1-1-3-1\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-user text-sm\" data-kid=\"1-1-1-3-1-1\">\n                    </i>\n                    Driver sign in\n                </button>\n                <button class=\"h-10 px-4 bg-[#D6A62E] text-[#073B32] text-[11px] font-black tracking-[.08em] hover:bg-[#e0b340]\" data-kid=\"1-1-1-3-2\" type=\"button\">\n                    BOOK A FITTING\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-1\" data-kid=\"1-1-1-3-2-1\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"bg-[#073B32] border-b border-[#D6A62E]/30\" data-kid=\"1-2-1\" id=\"hero-section\">\n            <div class=\"rr-hero-grid grid grid-cols-12 min-h-[650px]\" data-kid=\"1-2-1-1\">\n                <div class=\"rr-hero-copy col-span-7 relative min-h-[650px] overflow-hidden\" data-kid=\"1-2-1-1-1\">\n                    <img alt=\"Handcrafted vehicle interior with stitched leather seats\" class=\"absolute inset-0 w-full h-full object-cover object-center\" data-kid=\"1-2-1-1-1-1\" decoding=\"async\" fetchpriority=\"high\" src=\"/api/local/images/public/images/upholstery/upholstery-01.jpg\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-r from-[#073B32]/95 via-[#073B32]/72 to-[#073B32]/15\" data-kid=\"1-2-1-1-1-2\">\n                    </div>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#073B32] via-transparent to-[#073B32]/20\" data-kid=\"1-2-1-1-1-3\">\n                    </div>\n                    <div class=\"relative z-10 h-full max-w-[640px] px-8 lg:px-14 py-14 lg:py-20 flex flex-col justify-end\" data-kid=\"1-2-1-1-1-4\">\n                        <div class=\"flex items-center gap-3 text-[#D6A62E] text-[11px] font-bold tracking-[.18em] uppercase mb-6\" data-kid=\"1-2-1-1-1-4-1\">\n                            <span class=\"w-8 h-px bg-[#D6A62E]\" data-kid=\"1-2-1-1-1-4-1-1\">\n                            </span>\n                            Inspection bay / 01\n                        </div>\n                        <h1 class=\"text-[4.9rem] leading-[.94] tracking-[-.075em] font-black text-[#F5F1E8] max-w-[570px]\" data-kid=\"1-2-1-1-1-4-2\">\n                            Transform your ride.\n                            <br data-kid=\"1-2-1-1-1-4-2-1\"/>\n                            <span class=\"text-[#D6A62E]\" data-kid=\"1-2-1-1-1-4-2-2\">\n                                Made for your vehicle.\n                            </span>\n                        </h1>\n                        <p class=\"mt-7 max-w-[490px] text-[15px] leading-7 text-[#F5F1E8]/82\" data-kid=\"1-2-1-1-1-4-3\">\n                            Choose a service, see its starting KES price, then request a fitting at our Nairobi workshop or on-site.\n                        </p>\n                        <div class=\"mt-8 flex items-center gap-5 text-[12px] text-[#F5F1E8]/75\" data-kid=\"1-2-1-1-1-4-4\">\n                            <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-1-4-4-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-circle-check text-[#D6A62E]\" data-kid=\"1-2-1-1-1-4-4-1-1\">\n                                </i>\n                                M-Pesa deposits\n                            </span>\n                            <span class=\"w-1 h-1 bg-[#D6A62E] rounded-full\" data-kid=\"1-2-1-1-1-4-4-2\">\n                            </span>\n                            <span data-kid=\"1-2-1-1-1-4-4-3\">\n                                Free cancellation up to 24 hours\n                            </span>\n                        </div>\n                        <div class=\"mt-8 pt-5 border-t border-[#F5F1E8]/20 flex items-center gap-4 text-[12px]\" data-kid=\"1-2-1-1-1-4-5\">\n                            <span class=\"text-[#D6A62E] font-black rr-tabular\" data-kid=\"1-2-1-1-1-4-5-1\">\n                                4.9 / 5\n                            </span>\n                            <span class=\"text-[#F5F1E8]/65\" data-kid=\"1-2-1-1-1-4-5-2\">\n                                from verified drivers\n                            </span>\n                            <span class=\"text-[#D6A62E]\" data-kid=\"1-2-1-1-1-4-5-3\">\n                                •\n                            </span>\n                            <span class=\"text-[#F5F1E8]/65\" data-kid=\"1-2-1-1-1-4-5-4\">\n                                850+ rides transformed\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-span-5 bg-[#0B4035] px-7 lg:px-12 py-10 flex items-center\" data-kid=\"1-2-1-1-2\">\n                    <div class=\"w-full max-w-[490px] mx-auto\" data-kid=\"1-2-1-1-2-1\">\n                        <div class=\"flex items-start justify-between pb-5 border-b border-[#F5F1E8]/18\" data-kid=\"1-2-1-1-2-1-1\">\n                            <div data-kid=\"1-2-1-1-2-1-1-1\">\n                                <p class=\"text-[11px] tracking-[.15em] uppercase text-[#D6A62E] font-bold\" data-kid=\"1-2-1-1-2-1-1-1-1\">\n                                    Fitting request\n                                </p>\n                                <h2 class=\"mt-2 text-[27px] leading-tight font-black text-[#F5F1E8]\" data-kid=\"1-2-1-1-2-1-1-1-2\">\n                                    Start with the work.\n                                </h2>\n                                <p class=\"mt-1 text-[12px] text-[#F5F1E8]/62\" data-kid=\"1-2-1-1-2-1-1-1-3\">\n                                    Request a fitting time. We confirm availability with you.\n                                </p>\n                            </div>\n                            <div class=\"text-right pl-4\" data-kid=\"1-2-1-1-2-1-1-2\">\n                                <span class=\"block text-[10px] uppercase tracking-[.1em] text-[#F5F1E8]/45\" data-kid=\"1-2-1-1-2-1-1-2-1\">\n                                    Deposit\n                                </span>\n                                <strong class=\"text-[12px] text-[#D6A62E]\" data-kid=\"1-2-1-1-2-1-1-2-2\">\n                                    M-Pesa supported\n                                </strong>\n                            </div>\n                        </div>\n                        <form class=\"pt-6 space-y-5\" data-kid=\"1-2-1-1-2-1-2\">\n                            <label class=\"block\" data-kid=\"1-2-1-1-2-1-2-1\">\n                                <span class=\"block text-[11px] font-bold text-[#F5F1E8]/60 mb-2\" data-kid=\"1-2-1-1-2-1-2-1-1\">\n                                    01 / Choose a service\n                                </span>\n                                <span class=\"relative block\" data-kid=\"1-2-1-1-2-1-2-1-2\">\n                                    <select class=\"w-full h-12 appearance-none bg-[#073B32] border border-[#F5F1E8]/20 px-4 pr-10 text-[12px] font-semibold text-[#F5F1E8]\" data-kid=\"1-2-1-1-2-1-2-1-2-1\" data-name=\"service selection dropdown\">\n                                        <option data-kid=\"1-2-1-1-2-1-2-1-2-1-1\">\n                                            Car Upholstery — from KES 18,000\n                                        </option>\n                                        <option data-kid=\"1-2-1-1-2-1-2-1-2-1-2\">\n                                            Custom Car Seats — from KES 14,500\n                                        </option>\n                                        <option data-kid=\"1-2-1-1-2-1-2-1-2-1-3\">\n                                            Leather Work & Stitching — from KES 22,000\n                                        </option>\n                                        <option data-kid=\"1-2-1-1-2-1-2-1-2-1-4\">\n                                            Steering Wheel Stitching — from KES 4,500\n                                        </option>\n                                    </select>\n                                    <i aria-hidden=\"true\" class=\"ti ti-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-[#D6A62E]\" data-kid=\"1-2-1-1-2-1-2-1-2-2\">\n                                    </i>\n                                </span>\n                            </label>\n                            <div data-kid=\"1-2-1-1-2-1-2-2\">\n                                <span class=\"block text-[11px] font-bold text-[#F5F1E8]/60 mb-2\" data-kid=\"1-2-1-1-2-1-2-2-1\">\n                                    02 / Vehicle type\n                                </span>\n                                <div class=\"rr-vehicle-grid grid grid-cols-6 gap-1.5\" data-kid=\"1-2-1-1-2-1-2-2-2\">\n                                    <button class=\"h-10 bg-[#D6A62E] text-[#073B32] text-[11px] font-black\" data-kid=\"1-2-1-1-2-1-2-2-2-1\" type=\"button\">\n                                        Car\n                                    </button>\n                                    <button class=\"h-10 border border-[#F5F1E8]/18 text-[#F5F1E8]/72 text-[11px] font-bold\" data-kid=\"1-2-1-1-2-1-2-2-2-2\" type=\"button\">\n                                        SUV\n                                    </button>\n                                    <button class=\"h-10 border border-[#F5F1E8]/18 text-[#F5F1E8]/72 text-[11px] font-bold\" data-kid=\"1-2-1-1-2-1-2-2-2-3\" type=\"button\">\n                                        Van\n                                    </button>\n                                    <button class=\"h-10 border border-[#F5F1E8]/18 text-[#F5F1E8]/72 text-[11px] font-bold\" data-kid=\"1-2-1-1-2-1-2-2-2-4\" type=\"button\">\n                                        Truck\n                                    </button>\n                                    <button class=\"h-10 border border-[#F5F1E8]/18 text-[#F5F1E8]/72 text-[11px] font-bold\" data-kid=\"1-2-1-1-2-1-2-2-2-5\" type=\"button\">\n                                        Matatu\n                                    </button>\n                                    <button class=\"h-10 border border-[#F5F1E8]/18 text-[#F5F1E8]/72 text-[11px] font-bold\" data-kid=\"1-2-1-1-2-1-2-2-2-6\" type=\"button\">\n                                        Other\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"rr-form-two grid grid-cols-2 gap-3\" data-kid=\"1-2-1-1-2-1-2-3\">\n                                <label class=\"block\" data-kid=\"1-2-1-1-2-1-2-3-1\">\n                                    <span class=\"block text-[11px] font-bold text-[#F5F1E8]/60 mb-2\" data-kid=\"1-2-1-1-2-1-2-3-1-1\">\n                                        03 / Preferred date\n                                    </span>\n                                    <input class=\"w-full h-12 bg-[#073B32] border border-[#F5F1E8]/20 px-4 text-[12px] font-semibold text-[#F5F1E8]\" data-kid=\"1-2-1-1-2-1-2-3-1-2\" data-name=\"preferred date input field\" type=\"text\" value=\"12 Sep 2026\"/>\n                                </label>\n                                <label class=\"block\" data-kid=\"1-2-1-1-2-1-2-3-2\">\n                                    <span class=\"block text-[11px] font-bold text-[#F5F1E8]/60 mb-2\" data-kid=\"1-2-1-1-2-1-2-3-2-1\">\n                                        Preferred time\n                                    </span>\n                                    <select class=\"w-full h-12 bg-[#073B32] border border-[#F5F1E8]/20 px-4 text-[12px] font-semibold text-[#F5F1E8]\" data-kid=\"1-2-1-1-2-1-2-3-2-2\" data-name=\"preferred time selection dropdown\">\n                                        <option data-kid=\"1-2-1-1-2-1-2-3-2-2-1\">\n                                            10:00 AM – 12:00 PM\n                                        </option>\n                                        <option data-kid=\"1-2-1-1-2-1-2-3-2-2-2\">\n                                            8:00 AM – 10:00 AM\n                                        </option>\n                                    </select>\n                                </label>\n                            </div>\n                            <div data-kid=\"1-2-1-1-2-1-2-4\">\n                                <span class=\"block text-[11px] font-bold text-[#F5F1E8]/60 mb-2\" data-kid=\"1-2-1-1-2-1-2-4-1\">\n                                    04 / Fitting location\n                                </span>\n                                <div cl