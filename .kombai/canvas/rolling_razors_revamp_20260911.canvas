                 <button class=\"rr-pattern\" data-kid=\"1-2-3-2-2-3-2-3\">\n                                <span data-kid=\"1-2-3-2-2-3-2-3-1\">\n                                    Honeycomb hexagon\n                                </span>\n                            </button>\n                            <button class=\"rr-pattern\" data-kid=\"1-2-3-2-2-3-2-4\">\n                                <span data-kid=\"1-2-3-2-2-3-2-4-1\">\n                                    Classic horizontal pleats\n                                </span>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"rr-selected-line\" data-kid=\"1-2-3-2-2-4\">\n                        Nappa leather · Saddle brown & black · Diamond quilted\n                    </div>\n                    <div class=\"rr-caveat\" data-kid=\"1-2-3-2-2-5\">\n                        Preview shows the selected direction; final materials are confirmed at the workshop.\n                    </div>\n                    <button class=\"rr-btn rr-btn-ink\" data-kid=\"1-2-3-2-2-6\" style=\"margin-top:18px;width:100%\">\n                        Use this selection in my booking\n                        <span data-kid=\"1-2-3-2-2-6-1\">\n                            →\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section class=\"rr-handoff\" data-kid=\"1-2-4\" id=\"booking-route\">\n            <div class=\"rr-section-head\" data-kid=\"1-2-4-1\">\n                <div data-kid=\"1-2-4-1-1\">\n                    <div class=\"index\" data-kid=\"1-2-4-1-1-1\">\n                        04 / CONTENTS STRIP\n                    </div>\n                    <h2 data-kid=\"1-2-4-1-1-2\">\n                        Your appointment, in four parts\n                    </h2>\n                </div>\n                <p data-kid=\"1-2-4-1-2\">\n                    Move from a service choice to a fitting time without losing your material direction.\n                </p>\n            </div>\n            <div class=\"rr-steps\" data-kid=\"1-2-4-2\">\n                <div class=\"rr-step\" data-kid=\"1-2-4-2-1\">\n                    <div class=\"rr-step-num\" data-kid=\"1-2-4-2-1-1\">\n                        01\n                    </div>\n                    <h3 data-kid=\"1-2-4-2-1-2\">\n                        Choose a service\n                    </h3>\n                    <p data-kid=\"1-2-4-2-1-3\">\n                        Start with the work your vehicle needs and see the starting estimate.\n                    </p>\n                </div>\n                <div class=\"rr-step\" data-kid=\"1-2-4-2-2\">\n                    <div class=\"rr-step-num\" data-kid=\"1-2-4-2-2-1\">\n                        02\n                    </div>\n                    <h3 data-kid=\"1-2-4-2-2-2\">\n                        Select a fitting time\n                    </h3>\n                    <p data-kid=\"1-2-4-2-2-3\">\n                        Choose an available day and slot that works for your route.\n                    </p>\n                </div>\n                <div class=\"rr-step\" data-kid=\"1-2-4-2-3\">\n                    <div class=\"rr-step-num\" data-kid=\"1-2-4-2-3-1\">\n                        03\n                    </div>\n                    <h3 data-kid=\"1-2-4-2-3-2\">\n                        Tell us about the vehicle\n                    </h3>\n                    <p data-kid=\"1-2-4-2-3-3\">\n                        Share the make, model and finish direction for the workshop team.\n                    </p>\n                </div>\n                <div class=\"rr-step\" data-kid=\"1-2-4-2-4\">\n                    <div class=\"rr-step-num\" data-kid=\"1-2-4-2-4-1\">\n                        04\n                    </div>\n                    <h3 data-kid=\"1-2-4-2-4-2\">\n                        Bring it in or request mobile fit\n                    </h3>\n                    <p data-kid=\"1-2-4-2-4-3\">\n                        Pay the deposit with M-Pesa and we prepare the work order.\n                    </p>\n                    <button class=\"rr-btn rr-btn-gold\" data-kid=\"1-2-4-2-4-4\">\n                        Start booking\n                        <span data-kid=\"1-2-4-2-4-4-1\">\n                            →\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section class=\"rr-portfolio\" data-kid=\"1-2-5\" id=\"work\">\n            <div class=\"rr-portfolio-intro\" data-kid=\"1-2-5-1\">\n                <div data-kid=\"1-2-5-1-1\">\n                    <div class=\"index\" data-kid=\"1-2-5-1-1-1\" style=\"font-size:11px;letter-spacing:.14em;font-weight:900;color:var(--gold);margin-bottom:10px\">\n                        05 / WORK CATALOGUE\n                    </div>\n                    <h2 data-kid=\"1-2-5-1-1-2\">\n                        See the workmanship\n                    </h2>\n                </div>\n                <p data-kid=\"1-2-5-1-2\">\n                    Compare the change, then browse recent transformations by the work that was done.\n                </p>\n            </div>\n            <div class=\"rr-filters\" data-kid=\"1-2-5-2\">\n                <button class=\"active\" data-kid=\"1-2-5-2-1\">\n                    All work\n                </button>\n                <button data-kid=\"1-2-5-2-2\">\n                    Car interiors\n                </button>\n                <button data-kid=\"1-2-5-2-3\">\n                    Seats\n                </button>\n                <button data-kid=\"1-2-5-2-4\">\n                    Leather\n                </button>\n                <button data-kid=\"1-2-5-2-5\">\n                    Cushions\n                </button>\n                <button data-kid=\"1-2-5-2-6\">\n                    Canvas\n                </button>\n                <button data-kid=\"1-2-5-2-7\">\n                    Before & after\n                </button>\n            </div>\n            <div class=\"rr-comparison\" data-kid=\"1-2-5-3\">\n                <div class=\"rr-compare-frame\" data-kid=\"1-2-5-3-1\" data-name=\"before and after comparison viewer\">\n                    <div class=\"after\" data-kid=\"1-2-5-3-1-1\">\n                    </div>\n                    <div class=\"before\" data-kid=\"1-2-5-3-1-2\">\n                    </div>\n                    <span class=\"rr-compare-label before-l\" data-kid=\"1-2-5-3-1-3\">\n                        BEFORE\n                    </span>\n                    <span class=\"rr-compare-label after-l\" data-kid=\"1-2-5-3-1-4\">\n                        AFTER\n                    </span>\n                    <span class=\"rr-handle\" data-kid=\"1-2-5-3-1-5\">\n                        ↔\n                    </span>\n                </div>\n                <div class=\"rr-comparison-copy\" data-kid=\"1-2-5-3-2\">\n                    <div class=\"index\" data-kid=\"1-2-5-3-2-1\">\n                        FEATURED TRANSFORMATION · DRAG TO COMPARE\n                    </div>\n                    <h3 data-kid=\"1-2-5-3-2-2\">\n                        Toyota Probox full cabin overhaul\n                    </h3>\n                    <p data-kid=\"1-2-5-3-2-3\">\n                        A tired commercial cabin rebuilt as a comfortable executive commuter with tan double-stitched leatherette, matching door trims and noise-cancelling floor carpet.\n                    </p>\n                    <div class=\"meta\" data-kid=\"1-2-5-3-2-4\">\n                        Full upholstery · Toyota Probox 2018\n                        <br data-kid=\"1-2-5-3-2-4-1\"/>\n                        Nairobi, Kenya\n                    </div>\n                </div>\n            </div>\n            <div class=\"rr-contact-sheet\" data-kid=\"1-2-5-4\">\n                <figure class=\"rr-project tall\" data-kid=\"1-2-5-4-1\">\n                    <img alt=\"Land Cruiser Prado saddle leather restyle\" data-kid=\"1-2-5-4-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/upholstery/upholstery-10.jpg\"/>\n                    <figcaption data-kid=\"1-2-5-4-1-2\">\n                        <strong data-kid=\"1-2-5-4-1-2-1\">\n                            Land Cruiser Prado luxury saddle restyle\n                        </strong>\n                        <span data-kid=\"1-2-5-4-1-2-2\">\n                            Custom car seats & leather · Karen, Kenya\n                        </span>\n                        <p data-kid=\"1-2-5-4-1-2-3\">\n                            Perforated cooling zones and gold-thread double French stitching.\n                        </p>\n                    </figcaption>\n                </figure>\n                <figure class=\"rr-project medium\" data-kid=\"1-2-5-4-2\">\n                    <img alt=\"Subaru WRX Alcantara steering stitch\" data-kid=\"1-2-5-4-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/steering/steering-17.jpg\"/>\n                    <figcaption data-kid=\"1-2-5-4-2-2\">\n                        <strong data-kid=\"1-2-5-4-2-2-1\">\n                            Subaru WRX Alcantara steering stitch\n                        </strong>\n                        <span data-kid=\"1-2-5-4-2-2-2\">\n                            Steering wheel stitching · Nairobi, Kenya\n                        </span>\n                    </figcaption>\n                </figure>\n                <figure class=\"rr-project medium\" data-kid=\"1-2-5-4-3\">\n                    <img alt=\"Commercial 14 seater cushion overhaul\" data-kid=\"1-2-5-4-3-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/cushioning/cushioning-06.jpeg\"/>\n                    <figcaption data-kid=\"1-2-5-4-3-2\">\n                        <strong data-kid=\"1-2-5-4-3-2-1\">\n                            Commercial 14-seater overhaul\n                        </strong>\n                        <span data-kid=\"1-2-5-4-3-2-2\">\n                            Cushion customization · Mombasa Road\n                        </span>\n                    </figcaption>\n                </figure>\n                <figure class=\"rr-project small\" data-kid=\"1-2-5-4-4\">\n                    <img alt=\"Overland safari canopy and tent\" data-kid=\"1-2-5-4-4-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/tent/tent-01.jpeg\"/>\n                    <figcaption data-kid=\"1-2-5-4-4-2\">\n                        <strong data-kid=\"1-2-5-4-4-2-1\">\n                            Overland 4x4 safari canopy\n                        </strong>\n                        <span data-kid=\"1-2-5-4-4-2-2\">\n                            Tents & canvas work · Naivasha\n                        </span>\n                    </figcaption>\n                </figure>\n                <figure class=\"rr-project small\" data-kid=\"1-2-5-4-5\">\n                    <img alt=\"Mercedes starlight headliner and suede roof\" data-kid=\"1-2-5-4-5-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/upholstery/upholstery-04.jpg\"/>\n                    <figcaption data-kid=\"1-2-5-4-5-2\">\n                        <strong data-kid=\"1-2-5-4-5-2-1\">\n                            Mercedes starlight headliner\n                        </strong>\n                        <span data-kid=\"1-2-5-4-5-2-2\">\n                            Roofing & headliner · Kilimani\n                        </span>\n                    </figcaption>\n                </figure>\n            </div>\n        </section>\n        <section class=\"rr-proof\" data-kid=\"1-2-6\" id=\"proof\">\n            <div class=\"rr-proof-head\" data-kid=\"1-2-6-1\">\n                <div data-kid=\"1-2-6-1-1\">\n                    <div class=\"index\" data-kid=\"1-2-6-1-1-1\" style=\"font-size:11px;letter-spacing:.14em;font-weight:900;color:var(--gold);margin-bottom:10px\">\n                        06 / QUALITY CHECK\n                    </div>\n                    <h2 data-kid=\"1-2-6-1-1-2\">\n                        What we check before handover\n                    </h2>\n                </div>\n                <p data-kid=\"1-2-6-1-2\">\n                    Specific workshop standards, backed by the materials, fitting and care that go into every job.\n                </p>\n            </div>\n            <div class=\"rr-proof-layout\" data-kid=\"1-2-6-2\">\n                <div class=\"rr-ledger\" data-kid=\"1-2-6-2-1\">\n                    <div class=\"rr-ledger-row\" data-kid=\"1-2-6-2-1-1\">\n                        <div class=\"n\" data-kid=\"1-2-6-2-1-1-1\">\n                            01\n                        </div>\n                        <h3 data-kid=\"1-2-6-2-1-1-2\">\n                            Automotive-grade materials\n                        </h3>\n                        <p data-kid=\"1-2-6-2-1-1-3\">\n                            UV-stabilized hides, heavy vinyl and high-density foam selected for Kenyan heat, roads and daily use.\n                        </p>\n                    </div>\n                    <div class=\"rr-ledger-row\" data-kid=\"1-2-6-2-1-2\">\n                        <div class=\"n\" data-kid=\"1-2-6-2-1-2-1\">\n                            02\n                        </div>\n                        <h3 data-kid=\"1-2-6-2-1-2-2\">\n                            Measured to your vehicle\n                        </h3>\n                        <p data-kid=\"1-2-6-2-1-2-3\">\n                            Each seat and trim piece is shaped around the vehicle, bolsters and driver comfort—not pulled from a generic cover.\n                        </p>\n                    </div>\n                    <div class=\"rr-ledger-row\" data-kid=\"1-2-6-2-1-3\">\n                        <div class=\"n\" data-kid=\"1-2-6-2-1-3-1\">\n                            03\n                        </div>\n                        <h3 data-kid=\"1-2-6-2-1-3-2\">\n                            Clear estimate before fitting\n                        </h3>\n                        <p data-kid=\"1-2-6-2-1-3-3\">\n                            Choose the service, date, location and deposit route before your request becomes a workshop order.\n                        </p>\n                    </div>\n                    <div class=\"rr-ledger-row\" data-kid=\"1-2-6-2-1-4\">\n                        <div class=\"n\" data-kid=\"1-2-6-2-1-4-1\">\n                            04\n                        </div>\n                        <h3 data-kid=\"1-2-6-2-1-4-2\">\n                            Workshop or mobile fit\n                        </h3>\n                        <p data-kid=\"1-2-6-2-1-4-3\">\n                            Bring the vehicle to Industrial Area or request an on-site fitting where the job allows it.\n                        </p>\n                    </div>\n                    <div class=\"rr-ledger-row\" data-kid=\"1-2-6-2-1-5\">\n                        <div class=\"n\" data-kid=\"1-2-6-2-1-5-1\">\n                            05\n                        </div>\n                        <h3 data-kid=\"1-2-6-2-1-5-2\">\n                            One-year stitchwork warranty\n                        </h3>\n                        <p data-kid=\"1-2-6-2-1-5-3\">\n                            Warranty covers stitchwork, structural foams and material seams for one year.\n                        </p>\n                    </div>\n                </div>\n                <aside class=\"rr-review-note\" data-kid=\"1-2-6-2-2\">\n                    <blockquote data-kid=\"1-2-6-2-2-1\">\n                        “The stitching and finishing are excellent, and they finished on schedule.”\n                    </blockquote>\n                    <cite data-kid=\"1-2-6-2-2-2\">\n                        Brian M. · Toyota Fielder\n                        <span data-kid=\"1-2-6-2-2-2-1\">\n                            Full upholstery · Nairobi · Verified August 2026\n                        </span>\n                    </cite>\n                    <div class=\"rr-review-list\" data-kid=\"1-2-6-2-2-3\">\n                        <div class=\"rr-review-row\" data-kid=\"1-2-6-2-2-3-1\">\n                            <strong data-kid=\"1-2-6-2-2-3-1-1\">\n                                Kiprono C.\n                            </strong>\n                            <p data-kid=\"1-2-6-2-2-3-1-2\" data-name=\"review quote text\">\n                                “Worth every shilling.”\n                            </p>\n                            <span data-kid=\"1-2-6-2-2-3-1-3\" data-name=\"review customer details\">\n                                Prado · Eldoret\n                            </span>\n                        </div>\n                        <div class=\"rr-review-row\" data-kid=\"1-2-6-2-2-3-2\">\n                            <strong data-kid=\"1-2-6-2-2-3-2-1\">\n                                Esther N.\n                            </strong>\n                            <p data-kid=\"1-2-6-2-2-3-2-2\">\n                                “Delivered clean within 6 hours.”\n                            </p>\n                            <span data-kid=\"1-2-6-2-2-3-2-3\">\n                                Mazda · Nairobi\n                            </span>\n                        </div>\n                        <div class=\"rr-review-row\" data-kid=\"1-2-6-2-2-3-3\">\n                            <strong data-kid=\"1-2-6-2-2-3-3-1\">\n                                Captain D.\n                            </strong>\n                            <p data-kid=\"1-2-6-2-2-3-3-2\">\n                                “Better than brand new OEM.”\n                            </p>\n                            <span data-kid=\"1-2-6-2-2-3-3-3\">\n                                X-Trail · Mombasa\n                            </span>\n                        </div>\n                    </div>\n                </aside>\n            </div>\n        </section>\n        <section class=\"rr-visit\" data-kid=\"1-2-7\" id=\"visit\">\n            <div class=\"rr-visit-head\" data-kid=\"1-2-7-1\">\n                <div data-kid=\"1-2-7-1-1\">\n                    <div class=\"index\" data-kid=\"1-2-7-1-1-1\" style=\"font-size:11px;letter-spacing:.14em;font-weight:900;color:var(--gold);margin-bottom:10px\">\n                        07 / ARRIVAL BOARD\n                    </div>\n                    <h2 data-kid=\"1-2-7-1-1-2\">\n                        Find the workshop\n                    </h2>\n                </div>\n                <p data-kid=\"1-2-7-1-2\">\n                    Visit for a material inspection, leather swatch review or sit-down ergonomics consultation.\n                </p>\n            </div>\n            <div class=\"rr-arrival\" data-kid=\"1-2-7-2\">\n                <div class=\"rr-map\" data-kid=\"1-2-7-2-1\">\n                    <iframe data-kid=\"1-2-7-2-1-1\" data-name=\"google maps embedded iframe\" loading=\"lazy\" src=\"https://www.google.com/maps?q=-1.3098,36.8524&z=16&hl=en&output=embed\" title=\"Rolling Razors Customs workshop map\">\n                    </iframe>\n                    <div class=\"rr-map-badge\" data-kid=\"1-2-7-2-1-2\">\n                        Industrial Area · Nairobi\n                    </div>\n                    <button class=\"rr-btn rr-btn-gold\" data-kid=\"1-2-7-2-1-3\">\n                        Get directions\n                        <span data-kid=\"1-2-7-2-1-3-1\">\n                            ↗\n                        </span>\n                    </button>\n                </div>\n                <div class=\"rr-arrival-index\" data-kid=\"1-2-7-2-2\">\n                    <div class=\"rr-arrival-row\" data-kid=\"1-2-7-2-2-1\">\n                        <h3 data-kid=\"1-2-7-2-2-1-1\">\n                            Address\n                        </h3>\n                        <p data-kid=\"1-2-7-2-2-1-2\">\n                            Enterprise Road / Off Commercial Street\n                            <br data-kid=\"1-2-7-2-2-1-2-1\"/>\n                            Industrial Area, Nairobi, Kenya\n                            <br data-kid=\"1-2-7-2-2-1-2-2\"/>\n                            <span data-kid=\"1-2-7-2-2-1-2-3\" style=\"color:rgba(245,241,232,.55);font-size:11px\">\n                                Near Mombasa Road & Southern Bypass Interchange\n                            </span>\n                        </p>\n                    </div>\n                    <div class=\"rr-arrival-row\" data-kid=\"1-2-7-2-2-2\">\n                        <h3 data-kid=\"1-2-7-2-2-2-1\">\n                            Workshop hours\n                        </h3>\n                        <div class=\"rr-hours\" data-kid=\"1-2-7-2-2-2-2\">\n                            <span data-kid=\"1-2-7-2-2-2-2-1\">\n                                Monday – Friday\n                            </span>\n                            <span data-kid=\"1-2-7-2-2-2-2-2\">\n                                8:00 AM – 6:00 PM\n                            </span>\n                            <span data-kid=\"1-2-7-2-2-2-2-3\">\n                                Saturday\n                            </span>\n                            <span data-kid=\"1-2-7-2-2-2-2-4\">\n                                8:00 AM – 6:00 PM\n                            </span>\n                            <span data-kid=\"1-2-7-2-2-2-2-5\">\n                                Sunday\n                            </span>\n                            <span data-kid=\"1-2-7-2-2-2-2-6\">\n                                Special appointments only\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"rr-arrival-row\" data-kid=\"1-2-7-2-2-3\">\n                        <h3 data-kid=\"1-2-7-2-2-3-1\">\n                            Talk to the workshop\n                        </h3>\n                        <div class=\"rr-contact-actions\" data-kid=\"1-2-7-2-2-3-2\">\n                            <a class=\"rr-btn rr-btn-outline-light\" data-kid=\"1-2-7-2-2-3-2-1\" href=\"#\">\n                                Call 0712 345 678\n                            </a>\n                            <a class=\"rr-btn\" data-kid=\"1-2-7-2-2-3-2-2\" href=\"#\" style=\"background:var(--whatsapp);color:#062d25\">\n                                Chat on WhatsApp\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"rr-footer\" data-kid=\"1-3\">\n        <div class=\"rr-footer-top\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <div class=\"rr-footer-brand\" data-kid=\"1-3-1-1-1\">\n                    <div class=\"rr-brand-mark\" data-kid=\"1-3-1-1-1-1\">\n                        <span data-kid=\"1-3-1-1-1-1-1\">\n                        </span>\n                    </div>\n                    <strong data-kid=\"1-3-1-1-1-2\">\n                        ROLLING RAZORS\n                        <span data-kid=\"1-3-1-1-1-2-1\" style=\"color:var(--gold);font-size:9px;letter-spacing:.14em\">\n                            CUSTOMS\n                        </span>\n                    </strong>\n                </div>\n                <p data-kid=\"1-3-1-1-2\">\n                    Automotive upholstery, custom seats and vehicle interior work from Nairobi.\n                </p>\n            </div>\n            <div data-kid=\"1-3-1-2\">\n                <h4 data-kid=\"1-3-1-2-1\">\n                    Index\n                </h4>\n                <a data-kid=\"1-3-1-2-2\" href=\"#top\">\n                    Home\n                </a>\n                <a data-kid=\"1-3-1-2-3\" href=\"#services\">\n                    Services\n                </a>\n                <a data-kid=\"1-3-1-2-4\" href=\"#work\">\n                    Recent work\n                </a>\n                <a data-kid=\"1-3-1-2-5\" href=\"#visit\">\n                    Workshop\n                </a>\n            </div>\n            <div data-kid=\"1-3-1-3\">\n                <h4 data-kid=\"1-3-1-3-1\">\n                    Services\n                </h4>\n                <a data-kid=\"1-3-1-3-2\" href=\"#services\">\n                    Car upholstery\n                </a>\n                <a data-kid=\"1-3-1-3-3\" href=\"#services\">\n                    Custom car seats\n                </a>\n                <a data-kid=\"1-3-1-3-4\" href=\"#services\">\n                    Leather stitching\n                </a>\n                <a data-kid=\"1-3-1-3-5\" href=\"#services\">\n                    Cushion customization\n                </a>\n            </div>\n            <div data-kid=\"1-3-1-4\">\n                <h4 data-kid=\"1-3-1-4-1\">\n                    Driver portal\n                </h4>\n                <a data-kid=\"1-3-1-4-2\" href=\"#\">\n                    Driver sign in\n                </a>\n                <a data-kid=\"1-3-1-4-3\" href=\"#\">\n                    Book a fitting\n                </a>\n                <a data-kid=\"1-3-1-4-4\" href=\"#\">\n                    Privacy policy\n                </a>\n                <a data-kid=\"1-3-1-4-5\" href=\"#\">\n                    Terms of service\n                </a>\n            </div>\n        </div>\n        <div class=\"rr-footer-bottom\" data-kid=\"1-3-2\">\n            <span data-kid=\"1-3-2-1\">\n                © 2026 Rolling Razors Customs Kenya Limited\n            </span>\n            <span data-kid=\"1-3-2-2\">\n                Nairobi, Kenya · M-Pesa Paybill 400200\n            </span>\n        </div>\n    </footer>\n</div>\n",
