ia-hidden=\"true\" class=\"ti ti-navigation\" data-kid=\"1-2-7-1-2-1-3-1\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"col-span-4 bg-[#073B32] p-8 lg:p-10\" data-kid=\"1-2-7-1-2-2\">\n                        <div class=\"pb-7 border-b border-[#F5F1E8]/18\" data-kid=\"1-2-7-1-2-2-1\">\n                            <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold\" data-kid=\"1-2-7-1-2-2-1-1\">\n                                Rolling Razors Customs workshop\n                            </p>\n                            <h3 class=\"mt-3 text-xl font-bold\" data-kid=\"1-2-7-1-2-2-1-2\">\n                                Enterprise Road / Off Commercial Street\n                            </h3>\n                            <p class=\"mt-2 text-[12px] leading-5 text-[#F5F1E8]/62\" data-kid=\"1-2-7-1-2-2-1-3\">\n                                Industrial Area, Nairobi, Kenya\n                                <br data-kid=\"1-2-7-1-2-2-1-3-1\"/>\n                                Close to Mombasa Road & Southern Bypass Interchange\n                            </p>\n                        </div>\n                        <div class=\"pt-7\" data-kid=\"1-2-7-1-2-2-2\">\n                            <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold mb-4\" data-kid=\"1-2-7-1-2-2-2-1\">\n                                Workshop hours\n                            </p>\n                            <table class=\"rr-contact-table w-full text-[12px] rr-tabular\" data-kid=\"1-2-7-1-2-2-2-2\">\n                                <tbody data-kid=\"1-2-7-1-2-2-2-2-1\">\n                                    <tr data-kid=\"1-2-7-1-2-2-2-2-1-1\">\n                                        <td class=\"py-3 text-[#F5F1E8]/68\" data-kid=\"1-2-7-1-2-2-2-2-1-1-1\">\n                                            Monday – Friday\n                                        </td>\n 