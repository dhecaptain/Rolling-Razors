      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap');\n.rr-page{--green:#073B32;--green-2:#0B4035;--green-3:#052822;--gold:#D6A62E;--ivory:#F5F1E8;--ink:#17201E;--muted:#66706A;--whatsapp:#25D366;background:var(--ivory);color:var(--green);font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.01em;overflow:hidden}.rr-page *{box-sizing:border-box}.rr-page button,.rr-page a,.rr-page select,.rr-page input{font:inherit}.rr-page button,.rr-page a{cursor:pointer}.rr-page img{display:block}.rr-nav{height:82px;background:var(--green);color:var(--ivory);display:flex;align-items:center;justify-content:space-between;padding:0 64px;border-bottom:1px solid rgba(214,166,46,.42);position:relative;z-index:2}.rr-brand{display:flex;align-items:center;gap:12px;min-width:280px}.rr-brand-mark{width:40px;height:40px;border:1px solid var(--gold);display:grid;place-items:center;position:relative}.rr-brand-mark:before,.rr-brand-mark:after{content:'';position:absolute;width:22px;height:1.5px;background:var(--gold);transform:rotate(45deg)}.rr-brand-mark:after{transform:rotate(-45deg)}.rr-brand-mark span{width:7px;height:7px;background:var(--gold);transform:rotate(45deg);position:relative;z-index:1}.rr-brand-copy{display:flex;flex-direction:column;line-height:1}.rr-brand-copy strong{font-size:17px;letter-spacing:.045em}.rr-brand-copy strong em{font-size:10px;color:var(--gold);font-style:normal;letter-spacing:.16em;margin-left:4px}.rr-tagline{font:500 14px 'Caveat',cursive;color:var(--gold);margin-top:6px}.rr-nav-links{display:flex;gap:26px;align-items:center;font-size:12px;font-weight:700}.rr-nav-links a{color:rgba(245,241,232,.8);text-decoration:none}.rr-nav-links a:first-child{color:var(--gold)}.rr-nav-actions{display:flex;align-items:center;gap:13px}.rr-nav-actions a{color:var(--ivory);font-size:12px;text-decoration:none;border-bottom:1px solid rgba(245,241,232,.45);pad