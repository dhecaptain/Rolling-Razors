:uppercase;margin:3px 0;color:var(--muted);font-weight:800}.rr-service-rows{display:flex;flex-direction:column}.rr-service-row{display:grid;grid-template-columns:34px 1fr 105px 95px 26px;align-items:center;gap:12px;min-height:48px;border-bottom:1px solid rgba(7,59,50,.15);font-size:12px}.rr-service-row:last-child{border-bottom:0}.rr-service-row.active{border-left:3px solid var(--gold);padding-left:9px;background:rgba(214,166,46,.08)}.rr-service-row .num{font-size:11px;color:var(--gold);font-weight:900}.rr-service-row .name{font-weight:800}.rr-service-row .price,.rr-service-row .time{font-size:11px;color:var(--muted);text-align:right;font-weight:600}.rr-service-row .price{color:var(--green);font-weight:900}.rr-service-row .arrow{font-size:18px;text-align:right}.rr-service-detail{grid-column:2;background:rgba(214,166,46,.08);border-top:1px solid var(--gold);padding:13px 14px;display:flex;justify-content:space-between;gap:20px;align-items:center}.rr-service-detail p{margin:0;max-width:560px;font-size:11px;line-height:1.5;color:var(--muted)}.rr-service-detail a{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:var(--green);text-decoration:underline;text-underline-offset:4px;white-space:nowrap}.rr-sample{background:#e9e5d9;color:var(--green);padding:112px 64px;position:relative}.rr-sample .sample-top{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid rgba(7,59,50,.4);padding-bottom:25px;margin-bottom:35px}.rr-sample .sample-top h2{font-size:45px;line-height:1.02;letter-spacing:-.055em;margin:0;font-weight:900}.rr-sample .sample-top p{width:380px;font-size:13px;line-height:1.6;color:var(--muted);margin:0}.rr-sample-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:start}.rr-sample-visual{background:var(--green);padding:12px;position:relative}.rr-sample-visual img{width:100%;height:430px;object-fit:cover}.rr-sample-label{background:var(--ivory);position:absolute;left:26px;bottom:27px;padding:12px 14px;min-width:250px;border-left:3px solid var(--gold)}.rr-sample-label span{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);font-weight:800;margin-bottom:4px}.rr-sample-label strong{font-size:13px}.rr-sample-label small{display:block;font:500 17px 'Caveat',cursive;color:var(--gold);margin-top:4px}.rr-focus{position:absolute;right:28px;top:26px;border:1px solid var(--ivory);color:var(--ivory);background:rgba(7,59,50,.86);padding:8px 10px;font-size:10px;font-weight:800}.rr-control-sheet{border-top:2px solid var(--green)}.rr-control-row{padding:20px 0;border-bottom:1px solid rgba(7,59,50,.32)}.rr-control-row h3{font-size:11px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 12px;font-weight:900}.rr-materials{display:grid;grid-template-columns:1fr 1fr;gap:8px}.rr-material{display:grid;grid-template-columns:58px 1fr;gap:9px;align-items:center;border:1px solid rgba(7,59,50,.35);background:rgba(245,241,232,.6);padding:6px;text-align:left;min-height:60px;color:var(--green)}.rr-material.active{border:1.5px solid var(--gold);background:var(--ivory)}.rr-material img{width:58px;height:46px;object-fit:cover}.rr-material b{font-size:10px;line-height:1.25}.rr-material small{display:block;color:var(--muted);font-size:9px;margin-top:3px;line-height:1.25}.rr-swatches{display:flex;flex-wrap:wrap;gap:10px}.rr-swatch{border:1px solid transparent;padding:6px 8px;display:flex;align-items:center;gap:8px;background:transparent;color:var(--green);font-size:10px;font-weight:700}.rr-swatch.active{border-color:var(--gold);background:var(--ivory)}.rr-swatch i{width:24px;height:24px;display:block;border:1px solid rgba(7,59,50,.35)}.rr-patterns{display:flex;gap:8px;flex-wrap:wrap}.rr-pattern{height:40px;min-width:110px;border:1px solid rgba(7,59,50,.32);background:transparent;font-size:10px;font-weight:700;color:var(--green);position:relative;padding:0 10px;text-align:left}.rr-pattern:before{content:'';display:block;height:1px;background:var(--green);position:absolute;left:9px;right:9px;top:13px;box-shadow:10px 5px 0 -0.2px var(--green),20px 0 0 -0.2px var(--green),30px 5px 0 -0.2px var(--green),40px 0 0 -0.2px var(--green)}.rr-pattern span{position:absolute;bottom:5px;left:10px}.rr-pattern.active{border-color:var(--gold);background:var(--ivory)}.rr-selected-line{font-size:12px;font-weight:800;margin:20px 0 0;padding:14px 0;border-top:2px solid var(--green);border-bottom:1px solid var(--green)}.rr-caveat{font:500 18px 'Caveat',cursive;color:var(--gold);margin:14px 0 0}.rr-handoff{background:var(--green);color:var(--ivory);padding:86px 64px 82px;position:relative}.rr-handoff .rr-section-head{border-bottom-color:rgba(245,241,232,.3)}.rr-handoff .rr-section-head h2{color:var(--ivory)}.rr-handoff .rr-section-head p{color:rgba(245,241,232,.65)}.rr-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid rgba(214,166,46,.65);border-bottom:1px solid rgba(214,166,46,.65);position:relative}.rr-steps:before{content:'';position:absolute;left:11%;right:11%;top:49px;border-top:1px dashed rgba(214,166,46,.75)}.rr-step{position:relative;z-index:1;padding:27px 26px 25px 0;margin-right:25px;border-right:1px solid rgba(245,241,232,.22);min-height:180px}.rr-step:last-child{border-right:0;margin-right:0;padding-right:0}.rr-step-num{width:44px;height:44px;border:1px solid var(--gold);background:var(--green);display:grid;place-items:center;color:var(--gold);font-weight:900;font-size:15px;margin-bottom:26px}.rr-step h3{font-size:15px;margin:0 0 8px;color:var(--ivory)}.rr-step p{font-size:11px;line-height:1.55;color:rgba(245,241,232,.68);max-width:220px;margin:0}.rr-step .rr-btn{margin-top:18px;padding:10px 13px;font-size:10px}.rr-portfolio{padding:118px 64px 124px;background:var(--ivory);position:relative}.rr-portfolio:before,.rr-proof:before{content:'';position:absolute;left:18px;top:60px;bottom:60px;width:8px;background:radial-gradient(circle,var(--gold) 0 3px,transparent 3.5px);background