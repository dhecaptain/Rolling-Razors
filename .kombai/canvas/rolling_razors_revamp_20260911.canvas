p class=\"text-[10px] uppercase tracking-[.16em] font-bold text-[#073B32]/52\" data-kid=\"1-2-5-1-4-1-1\">\n                            Featured file / P-01\n                        </p>\n                        <h3 class=\"mt-4 text-2xl leading-tight font-black tracking-[-.04em]\" data-kid=\"1-2-5-1-4-1-2\">\n                            Toyota Probox Full Cabin Overhaul\n                        </h3>\n                        <div class=\"rr-photo-caption mt-5 pt-4 text-[12px] text-[#073B32]/65\" data-kid=\"1-2-5-1-4-1-3\">\n                            <p class=\"font-bold text-[#073B32]\" data-kid=\"1-2-5-1-4-1-3-1\">\n                                Full upholstery · Nairobi, Kenya\n                            </p>\n                            <p class=\"mt-2 leading-5\" data-kid=\"1-2-5-1-4-1-3-2\">\n                                A tired commercial cabin converted into a tan double-stitched executive commuter.\n                            </p>\n                        </div>\n                        <button class=\"mt-7 text-[11px] font-black border-b-2 border-[#D6A62E] pb-1\" data-kid=\"1-2-5-1-4-1-4\" type=\"button\">\n                            OPEN PROJECT FILE\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-1\" data-kid=\"1-2-5-1-4-1-4-1\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"grid rr-portfolio-grid grid-cols-[3fr_2fr_4fr_3fr] gap-7 mt-16\" data-kid=\"1-2-5-1-5\">\n                    <figure data-kid=\"1-2-5-1-5-1\">\n                        <img alt=\"Land Cruiser Prado leather restyle\" class=\"w-full h-[235px] object-cover\" data-kid=\"1-2-5-1-5-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/upholstery/upholstery-10.jpg\"/>\n                        <figcaption class=\"rr-photo-caption mt-3 pt-3\" data-kid=\"1-2-5-1-5-1-2\">\n                            <strong class=\"block text-[13px]\" data-kid=\"1-2-5-1-5-1-2-1\">\n                                Land Cruiser Prado Luxury Restyle\n                            </strong>\n                            <span class=\"block mt-1 text-[11px] text-[#073B32]/58\" data-kid=\"1-2-5-1-5-1-2-2\">\n                                Custom seats · Karen, Kenya\n                            </span>\n                        </figcaption>\n                    </figure>\n                    <figure class=\"mt-8\" data-kid=\"1-2-5-1-5-2\">\n                        <img alt=\"Subaru WRX Alcantara steering stitch\" class=\"w-full h-[285px] object-cover\" data-kid=\"1-2-5-1-5-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/steering/steering-17.jpg\"/>\n                        <figcaption class=\"rr-photo-caption mt-3 pt-3\" data-kid=\"1-2-5-1-5-2-2\">\n                            <strong class=\"block text-[13px]\" data-kid=\"1-2-5-1-5-2-2-1\">\n                                Subaru WRX Alcantara Stitch\n                            </strong>\n                            <span class=\"block mt-1 text-[11px] text-[#073B32]/58\" data-kid=\"1-2-5-1-5-2-2-2\">\n                                Steering work · Nairobi\n                            </span>\n                        </figcaption>\n                    </figure>\n                    <figure data-kid=\"1-2-5-1-5-3\">\n                        <img alt=\"Commercial 14-seater cushion overhaul\" class=\"w-full h-[220px] object-cover\" data-kid=\"1-2-5-1-5-3-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/cushioning/cushioning-06.jpeg\"/>\n                        <figcaption class=\"rr-photo-caption mt-3 pt-3\" data-kid=\"1-2-5-1-5-3-2\">\n                            <strong class=\"block text-[13px]\" data-kid=\"1-2-5-1-5-3-2-1\">\n                                14-Seater Heavy-Duty Overhaul\n                            </strong>\n                            <span class=\"block mt-1 text-[11px] text-[#073B32]/58\" data-kid=\"1-2-5-1-5-3-2-2\">\n                                Cushion work · Mombasa Road\n                            </span>\n                        </figcaption>\n                    </figure>\n                    <figure class=\"mt-8\" data-kid=\"1-2-5-1-5-4\">\n                        <img alt=\"Overland safari canvas canopy\" class=\"w-full h-[285px] object-cover\" data-kid=\"1-2-5-1-5-4-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/tent/tent-01.jpeg\"/>\n                        <figcaption class=\"rr-photo-caption mt-3 pt-3\" data-kid=\"1-2-5-1-5-4-2\">\n                            <strong class=\"block text-[13px]\" data-kid=\"1-2-5-1-5-4-2-1\">\n                                Overland Safari Canopy\n                            </strong>\n                            <span class=\"block mt-1 text-[11px] text-[#073B32]/58\" data-kid=\"1-2-5-1-5-4-2-2\">\n                                Canvas work · Naivasha\n                            </span>\n                        </figcaption>\n                    </figure>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#073B32] text-[#F5F1E8] px-5 lg:px-12 py-24 lg:py-28\" data-kid=\"1-2-6\" id=\"quality-section\">\n            <div class=\"max-w-[1280px] mx-auto\" data-kid=\"1-2-6-1\">\n                <div class=\"flex flex-col lg:flex-row justify-between gap-8 mb-12\" data-kid=\"1-2-6-1-1\">\n                    <div data-kid=\"1-2-6-1-1-1\">\n                        <p class=\"text-[11px] font-bold tracking-[.18em] uppercase text-[#D6A62E]\" data-kid=\"1-2-6-1-1-1-1\">\n                            06 / Quality check\n                        </p>\n                        <h2 class=\"mt-4 text-[3.15rem] leading-none tracking-[-.065em] font-black\" data-kid=\"1-2-6-1-1-1-2\">\n                            What we check.\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[400px] text-[13px] leading-6 text-[#F5F1E8]/62\" data-kid=\"1-2-6-1-1-2\">\n                        The finish is in the details: materials, fit, road use, clear booking, and a warranty you can bring back to us.\n                    </p>\n                </div>\n                <div class=\"rr-register-grid grid grid-cols-12 gap-8 items-stretch\" data-kid=\"1-2-6-1-2\">\n                    <div class=\"rr-quality-ledger col-span-9 border-t border-[#F5F1E8]/22\" data-kid=\"1-2-6-1-2-1\">\n                        <div class=\"rr-quality-row grid grid-cols-[62px_220px_1fr] gap-5 py-5 items-start\" data-kid=\"1-2-6-1-2-1-1\">\n                            <span class=\"text-[28px] text-[#D6A62E] font-black rr-tabular\" data-kid=\"1-2-6-1-2-1-1-1\">\n                                01\n                            </span>\n                            <h3 class=\"text-[15px] font-bold\" data-kid=\"1-2-6-1-2-1-1-2\">\n                                Premium materials\n                            </h3>\n                            <p class=\"text-[12px] leading-5 text-[#F5F1E8]/62\" data-kid=\"1-2-6-1-2-1-1-3\">\n                                Automotive-grade hides, UV-stabilized vinyl, and high-density foam selected for comfort and long-term durability.\n                            </p>\n                        </div>\n                        <div class=\"rr-quality-row grid grid-cols-[62px_220px_1fr] gap-5 py-5 items-start\" data-kid=\"1-2-6-1-2-1-2\">\n                            <span class=\"text-[28px] text-[#D6A62E] font-black rr-tabular\" data-kid=\"1-2-6-1-2-1-2-1\">\n                                02\n                            </span>\n                            <h3 class=\"text-[15px] font-bold\" data-kid=\"1-2-6-1-2-1-2-2\">\n                                Measured craftsmanship\n                            </h3>\n                            <p class=\"text-[12px] leading-5 text-[#F5F1E8]/62\" data-kid=\"1-2-6-1-2-1-2-3\">\n                                Projects are measured and hand-stitched around your driving position, bolster requirements, and style direction.\n                            </p>\n                        </div>\n                        <div class=\"rr-quality-row grid grid-cols-[62px_220px_1fr] gap-5 py-5 items-start\" data-kid=\"1-2-6-1-2-1-3\">\n                            <span class=\"text-[28px] text-[#D6A62E] font-black rr-tabular\" data-kid=\"1-2-6-1-2-1-3-1\">\n                                03\n                            </span>\n                            <h3 class=\"text-[15px] font-bold\" data-kid=\"1-2-6-1-2-1-3-2\">\n                                Transparent booking\n                            </h3>\n                            <p class=\"text-[12px] leading-5 text-[#F5F1E8]/62\" data-kid=\"1-2-6-1-2-1-3-3\">\n                                See the service estimate, deposit amount, fitting slot, and M-Pesa payment route before arrival.\n                            </p>\n                        </div>\n                        <div class=\"rr-quality-row grid grid-cols-[62px_220px_1fr] gap-5 py-5 items-start\" data-kid=\"1-2-6-1-2-1-4\">\n                            <span class=\"text-[28px] text-[#D6A62E] font-black rr-tabular\" data-kid=\"1-2-6-1-2-1-4-1\">\n                                04\n                            </span>\n                            <h3 class=\"text-[15px] font-bold\" data-kid=\"1-2-6-1-2-1-4-2\">\n                                Built for Kenyan roads\n                            </h3>\n                            <p class=\"text-[12px] leading-5 text-[#F5F1E8]/62\" data-kid=\"1-2-6-1-2-1-4-3\">\n                                Seams, foams, and materials are selected for dust roads, heat, rain, and heavy commercial use.\n                            </p>\n                        </div>\n                        <div class=\"rr-quality-row grid grid-cols-[62px_220px_1fr] gap-5 py-5 items-start\" data-kid=\"1-2-6-1-2-1-5\">\n                            <span class=\"text-[28px] text-[#D6A62E] font-black rr-tabular\" data-kid=\"1-2-6-1-2-1-5-1\">\n                                05\n                            </span>\n                            <h3 class=\"text-[15px] font-bold\" data-kid=\"1-2-6-1-2-1-5-2\">\n                                One-year warranty\n                            </h3>\n                            <p class=\"text-[12px] leading-5 text-[#F5F1E8]/62\" data-kid=\"1-2-6-1-2-1-5-3\">\n                                A 1-year warranty covers stitchwork, structural foams, and material seams across completed work.\n                            </p>\n                        </div>\n                    </div>\n                    <aside class=\"rr-quality-note col-span-3 bg-[#F5F1E8] text-[#073B32] p-8 self-stretch\" data-kid=\"1-2-6-1-2-2\">\n                        <p class=\"text-[10px] uppercase tracking-[.16em] font-bold text-[#073B32]/55\" data-kid=\"1-2-6-1-2-2-1\">\n                            Driver note / verified\n                        </p>\n                        <div class=\"rr-signature text-[41px] leading-none mt-6 text-[#0B4035]\" data-kid=\"1-2-6-1-2-2-2\">\n                            “Worth every shilling.”\n                        </div>\n                        <blockquote class=\"mt-5 text-[17px] leading-7 font-semibold\" data-kid=\"1-2-6-1-2-2-3\">\n                            “The craftsmanship on my Prado seats is unmatched. Drove all the way from Eldoret to their workshop and it was worth every shilling.”\n                        </blockquote>\n                        <div class=\"mt-8 pt-5 border-t border-[#073B32]/18 flex items-end justify-between\" data-kid=\"1-2-6-1-2-2-4\">\n                            <div data-kid=\"1-2-6-1-2-2-4-1\">\n                                <strong class=\"block text-[12px]\" data-kid=\"1-2-6-1-2-2-4-1-1\">\n                                    Kiprono Cheruiyot\n                                </strong>\n                                <spa