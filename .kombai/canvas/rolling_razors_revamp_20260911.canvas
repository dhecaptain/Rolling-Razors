1-1\">\n                            </i>\n                            CALL 0712 345 678\n                        </a>\n                        <a class=\"h-12 bg-[#25D366] text-white flex items-center justify-center gap-2 text-[11px] font-black\" data-kid=\"1-2-7-1-2-3-2\" href=\"https://wa.me/254712345678\">\n                            <i aria-hidden=\"true\" class=\"ti ti-brand-whatsapp\" data-kid=\"1-2-7-1-2-3-2-1\">\n                            </i>\n                            WHATSAPP\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#052822] text-[#F5F1E8] px-5 lg:px-12 py-14 border-t border-[#D6A62E]/25\" data-kid=\"1-3\">\n        <div class=\"rr-footer-grid max-w-[1280px] mx-auto grid grid-cols-12 gap-10\" data-kid=\"1-3-1\">\n            <div class=\"col-span-5\" data-kid=\"1-3-1-1\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1\">\n                    <span class=\"w-9 h-9 border border-[#D6A62E]/70 bg-[#073B32] grid place-items-center text-[#D6A62E]\" data-kid=\"1-3-1-1-1-1\">\n                        <i aria-hidden=\"true\" class=\"ti ti-scissors text-lg\" data-kid=\"1-3-1-1-1-1-1\">\n                        </i>\n                    </span>\n                    <span class=\"font-black tracking-[-.03em]\" data-kid=\"1-3-1-1-1-2\">\n                        ROLLING RAZORS\n                        <b class=\"text-[10px] tracking-[.15em] text-[#D6A62E]\" data-kid=\"1-3-1-1-1-2-1\">\n                            CUSTOMS\n                        </b>\n                    </span>\n                </div>\n                <p class=\"mt-5 max-w-[340px] text-[12px] leading-5 text-[#F5F1E8]/58\" data-kid=\"1-3-1-1-2\">\n                    Automotive upholstery, custom seats, leather work, cushions, canvas, and vehicle interiors in Nairobi.\n                </p>\n                <p class=\"rr-signature mt-5 text-[#D6A62E] text-[19px]\" data-kid=\"1-3-1-1-3\">\n                    Your Vision, Our Craftsmanship.\n                </p>\n            </div>\n            <div class=\"col-span-2\" data-kid=\"1-3-1-2\">\n                <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold\" data-kid=\"1-3-1-2-1\">\n                    Explore\n                </p>\n                <div class=\"mt-4 space-y-3 text-[12px] text-[#F5F1E8]/65\" data-kid=\"1-3-1-2-2\">\n                    <a class=\"block hover:text-[#D6A62E]\" data-kid=\"1-3-1-2-2-1\" href=\"#services-section\">\n                        Services\n                    </a>\n                    <a class=\"block hover:text-[#D6A62E]\" data-kid=\"1-3-1-2-2-2\" href=\"#spec-section\">\n                        Build spec\n                    </a>\n                    <a class=\"block hover:text-[#D6A62E]\" data-kid=\"1-3-1-2-2-3\" href=\"#portfolio-section\">\n                        Our work\n                    </a>\n                    <a class=\"block hover:text-[#D6A62E]\" data-kid=\"1-3-1-2-2-4\" href=\"#arrival-section\">\n                        Workshop\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-span-3\" data-kid=\"1-3-1-3\">\n                <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold\" data-kid=\"1-3-1-3-1\">\n                    Popular work\n                </p>\n                <div class=\"mt-4 space-y-3 text-[12px] text-[#F5F1E8]/65\" data-kid=\"1-3-1-3-2\">\n                    <span class=\"block\" data-kid=\"1-3-1-3-2-1\">\n                        Car Upholstery\n                    </span>\n                    <span class=\"block\" data-kid=\"1-3-1-3-2-2\">\n                        Custom Car Seats\n                    </span>\n                    <span class=\"block\" data-kid=\"1-3-1-3-2-3\">\n                        Leather Work & Stitching\n                    </span>\n                    <span class=\"block\" data-kid=\"1-3-1-3-2-4\">\n                        Steering Wheel Stitching\n                    </span>\n                </div>\n            </div>\n            <div class=\"col-span-2\" data-kid=\"1-3-1-4\">\n                <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold\" data-kid=\"1-3-1-4-1\">\n                    Connect\n                </p>\n                <p class=\"mt-4 text-[12px] text-[#F5F1E8]/65\" data-kid=\"1-3-1-4-2\">\n                    0712 345 678\n                    <br data-kid=\"1-3-1-4-2-1\"/>\n                    info@rollingrazors.co.ke\n                </p>\n                <div class=\"mt-5 flex gap-3 text-[#F5F1E8]/75 text-lg\" data-kid=\"1-3-1-4-3\">\n                    <a aria-label=\"Facebook\" data-kid=\"1-3-1-4-3-1\" href=\"https://facebook.com/rollingrazorskenya\" rel=\"noreferrer\" target=\"_blank\">\n                        <i class=\"ti ti-brand-facebook\" data-kid=\"1-3-1-4-3-1-1\">\n                        </i>\n                    </a>\n                    <a aria-label=\"Instagram\" data-kid=\"1-3-1-4-3-2\" href=\"https://instagram.com/rollingrazorscustoms\" rel=\"noreferrer\" target=\"_blank\">\n                        <i class=\"ti ti-brand-instagram\" data-kid=\"1-3-1-4-3-2-1\">\n                        </i>\n                    </a>\n                    <a aria-label=\"TikTok\" data-kid=\"1-3-1-4-3-3\" href=\"https://tiktok.com/@rollingrazorscustoms\" rel=\"noreferrer\" target=\"_blank\">\n                        <i class=\"ti ti-brand-tiktok\" data-kid=\"1-3-1-4-3-3-1\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div class=\"max-w-[1280px] mx-auto mt-12 pt-5 border-t border-[#F5F1E8]/12 flex flex-col sm:flex-row justify-between gap-3 text-[10px] text-[#F5F1E8]/42\" data-kid=\"1-3-2\">\n            <span data-kid=\"1-3-2-1\">\n                © 2026 Rolling Razors Customs Kenya Limited · Nairobi, Kenya\n            </span>\n            <span data-kid=\"1-3-2-2\">\n                Privacy · Terms · Refund policy\n            </span>\n        </div>\n    </footer>\n    <script>\n        (() => {\n      const rows = [...document.querySelectorAll('.rr-service-row')];\n      const img = document.getElementById('service-board-image');\n      const title = document.getElementById('service-board-title');\n      const price = document.getElementById('service-board-price');\n      const time = document.getElementById('service-board-time');\n      const desc = document.querySelector('#service-board-title + p');\n      rows.forEach(row => row.addEventListener('click', () => { rows.forEach(r => r.classList.remove('is-active')); row.classList.add('is-active'); img.src = row.dataset.image; title.textContent = row.dataset.service; price.textContent = row.dataset.price; time.textContent = row.dataset.time; if (desc) desc.textContent = row.dataset.desc; }));\n      let material = 'Nappa leather', color = 'Saddle brown & black', pattern = 'Diamond quilted';\n      const syncSpec = () => { const node = document.getElementById('spec-summary'); if (node) node.innerHTML = material + ' <span class=\"text-[#D6A62E]\">·</span> ' + color + ' <span class=\"text-[#D6A62E]\">·</span> ' + pattern; };\n      document.querySelectorAll('.rr-material').forEach(btn => btn.addEventListener('click', () => { document.querySelectorAll('.rr-material').forEach(b => b.classList.remove('is-active')); btn.classList.add('is-active'); material = btn.dataset.spec; const preview = document.getElementById('spec-image'); if (preview) preview.src = btn.dataset.specImage; syncSpec(); }));\n      document.querySelectorAll('.rr-swatch').forEach(btn => btn.addEventListener('click', () => { document.querySelectorAll('.rr-swatch').forEach(b => b.classList.remove('is-active')); btn.classList.add('is-active'); color = btn.dataset.color; syncSpec(); }));\n      document.querySelectorAll('.rr-pattern').forEach(btn => btn.addEventListener('click', () => { document.querySelectorAll('.rr-pattern').forEach(b => b.classList.remove('is-active')); btn.classList.add('is-active'); pattern = btn.dataset.pattern; syncSpec(); }));\n      document.querySelectorAll('.rr-filter').forEach(btn => btn.addEventListener('click', () => { document.querySelectorAll('.rr-filter').forEach(b => b.classList.remove('is-active')); btn.classList.add('is-active'); }));\n      const slider = document.querySelector('.rr-slider'); if (slider) { const set = x => { const rect = slider.getBoundingClientRect(); const pct = Math.max(3, Math.min(97, ((x - rect.left) / rect.width) * 100)); const before = slider.querySelector('div.absolute.inset-y-0'); const seam = slider.querySelector('div.absolute.top-0'); if (before) before.style.width = pct + '%'; if (seam) seam.style.left = pct + '%'; slider.setAttribute('aria-valuenow', Math.round(pct)); }; slider.addEventListener('pointermove', e => { if (e.buttons) set(e.clientX); }); slider.addEventListener('pointerdown', e => { slider.setPointerCapture(e.pointerId); set(e.clientX); }); slider.addEventListener('keydown', e => { const current = Number(slider.getAttribute('aria-valuenow') || 46); if (e.key === 'ArrowLeft') set(slider.getBoundingClientRect().left + slider.getBoundingClientRect().width * ((current - 5) / 100)); if (e.key === 'ArrowRight') set(slider.getBoundingClientRect().left + slider.getBoundingClientRect().width * ((current + 5) / 100)); }); }\n    })();\n    </script>\n</div>\n",
