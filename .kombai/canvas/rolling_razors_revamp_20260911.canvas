  <span class=\"text-[11px] text-[#F5F1E8]/45\" data-kid=\"1-2-3-1-2-2-2-2-1-2\">\n                                        Choose one\n                                    </span>\n                                </div>\n                                <div class=\"grid grid-cols-2 gap-x-4 gap-y-2 mt-4\" data-kid=\"1-2-3-1-2-2-2-2-2\">\n                                    <button class=\"rr-pattern is-active text-left border-b border-[#D6A62E] pb-2\" data-kid=\"1-2-3-1-2-2-2-2-2-1\" data-pattern=\"Diamond quilted\">\n                                        <span class=\"block h-4 bg-[linear-gradient(45deg,transparent_45%,#D6A62E_46%,#D6A62E_50%,transparent_51%),linear-gradient(-45deg,transparent_45%,#D6A62E_46%,#D6A62E_50%,transparent_51%)] bg-[length:12px_12px]\" data-kid=\"1-2-3-1-2-2-2-2-2-1-1\">\n                                        </span>\n                                        <span class=\"block text-[11px] font-bold mt-2\" data-kid=\"1-2-3-1-2-2-2-2-2-1-2\">\n                                            Diamond Quilted\n                                        </span>\n                                    </button>\n                                    <button class=\"rr-pattern text-left border-b border-[#F5F1E8]/20 pb-2\" data-kid=\"1-2-3-1-2-2-2-2-2-2\" data-pattern=\"Double French stitch\">\n                                        <span class=\"block h-4 border-y border-[#F5F1E8]/45\" data-kid=\"1-2-3-1-2-2-2-2-2-2-1\">\n                                        </span>\n                                        <span class=\"block text-[11px] font-bold mt-2\" data-kid=\"1-2-3-1-2-2-2-2-2-2-2\">\n                                            Double French\n                                        </span>\n                                    </button>\n                                    <button class=\"rr-pattern text-left border-b border-[#F5F1E8]/20 pb-2\" data-kid=\"1-2-3-1-2-2-2-2-2-3\" data-pattern=\"Perforated motorsport\">\n                                        <span class=\"block h-4 bg-[radial-gradient(#D6A62E_1px,transparent_1.4px)] bg-[length:7px_7px]\" data-kid=\"1-2-3-1-2-2-2-2-2-3-1\">\n                                        </span>\n                                        <span class=\"block text-[11px] font-bold mt-2\" data-kid=\"1-2-3-1-2-2-2-2-2-3-2\">\n                                            Perforated Motorsport\n                                        </span>\n                                    </button>\n                                    <button class=\"rr-pattern text-left border-b border-[#F5F1E8]/20 pb-2\" data-kid=\"1-2-3-1-2-2-2-2-2-4\" data-pattern=\"Classic horizontal pleats\">\n                                        <span class=\"block h-4 border-y-2 border-[#F5F1E8]/40\" data-kid=\"1-2-3-1-2-2-2-2-2-4-1\">\n                                        </span>\n                                        <span class=\"block text-[11px] font-bold mt-2\" data-kid=\"1-2-3-1-2-2-2-2-2-4-2\">\n                                            Horizontal Pleats\n                                        </span>\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"mt-auto h-14 bg-[#D6A62E] text-[#073B32] text-[12px] font-black tracking-[.1em]\" data-kid=\"1-2-3-1-2-2-3\" type=\"button\">\n                            BOOK THIS INTERIOR BUILD\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right ml-2\" data-kid=\"1-2-3-1-2-2-3-1\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#0B4035] text-[#F5F1E8] px-5 lg:px-12 py-24 lg:py-28\" data-kid=\"1-2-4\" id=\"booking-route\">\n            <div class=\"max-w-[1280px] mx-auto\" data-kid=\"1-2-4-1\">\n                <div class=\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-14\" data-kid=\"1-2-4-1-1\">\n                    <div data-kid=\"1-2-4-1-1-1\">\n                        <p class=\"text-[11px] font-bold tracking-[.18em] uppercase text-[#D6A62E]\" data-kid=\"1-2-4-1-1-1-1\">\n                            04 / Booking handoff\n                        </p>\n                        <h2 class=\"mt-4 text-[3.1rem] leading-none tracking-[-.065em] font-black\" data-kid=\"1-2-4-1-1-1-2\">\n                            From selection to fitting.\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[390px] text-[13px] leading-6 text-[#F5F1E8]/60\" data-kid=\"1-2-4-1-1-2\">\n                        Four clear steps take your request from a service choice to a confirmed Nairobi workshop appointment.\n                    </p>\n                </div>\n                <div class=\"rr-route-core grid grid-cols-12 gap-8 max-w-[1000px] mx-auto\" data-kid=\"1-2-4-1-2\">\n                    <div class=\"rr-route-steps col-span-8 relative\" data-kid=\"1-2-4-1-2-1\">\n                        <div class=\"rr-route-line absolute left-[33px] top-7 bottom-7 border-l border-dashed border-[#D6A62E]/65\" data-kid=\"1-2-4-1-2-1-1\">\n                        </div>\n                        <div class=\"rr-route-step relative pl-20 py-5 border-t border-[#F5F1E8]/16\" data-kid=\"1-2-4-1-2-1-2\">\n                            <span class=\"absolute left-0 top-4 w-[68px] h-[68px] bg-[#073B32] border border-[#D6A62E] grid place-items-center text-[22px] font-black text-[#D6A62E] rr-tabular\" data-kid=\"1-2-4-1-2-1-2-1\">\n                                01\n                            </span>\n                            <h3 class=\"text-[19px] font-bold\" data-kid=\"1-2-4-1-2-1-2-2\">\n                                Choose a service\n                            </h3>\n                            <p class=\"mt-2 text-[12px] leading-5 text-[#F5F1E8]/62 max-w-[500px]\" data-kid=\"1-2-4-1-2-1-2-3\">\n                                Select full upholstery, custom seats, leather work, steering stitching, cushions, shades, or a workshop service.\n                            </p>\n                        </div>\n                        <div class=\"rr-route-step relative pl-20 py-5 border-t border-[#F5F1E8]/16\" data-kid=\"1-2-4-1-2-1-3\">\n                            <span class=\"absolute left-0 top-4 w-[68px] h-[68px] bg-[#073B32] border border-[#F5F1E8]/32 grid place-items-center text-[22px] font-black text-[#F5F1E8]/72 rr-tabular\" data-kid=\"1-2-4-1-2-1-3-1\">\n                                02\n                            </span>\n                            <h3 class=\"text-[19px] font-bold\" data-kid=\"1-2-4-1-2-1-3-2\">\n                                Select a fitting time\n                            </h3>\n                            <p class=\"mt-2 text-[12px] leading-5 text-[#F5F1E8]/62 max-w-[500px]\" data-kid=\"1-2-4-1-2-1-3-3\">\n                                Pick a preferred day and time slot. We check the workshop schedule before confirming the visit.\n                            </p>\n                        </div>\n                        <div class=\"rr-route-step relative pl-20 py-5 border-t border-[#F5F1E8]/16\" data-kid=\"1-2-4-1-2-1-4\">\n                            <span class=\"absolute left-0 top-4 w-[68px] h-[68px] bg-[#073B32] border border-[#F5F1E8]/32 grid place-items-center text-[22px] font-black text-[#F5F1E8]/72 rr-tabular\" data-kid=\"1-2-4-1-2-1-4-1\">\n                                03\n                            </span>\n                            <h3 class=\"text-[19px] font-bold\" data-kid=\"1-2-4-1-2-1-4-2\">\n                                Tell us about your vehicle\n                            </h3>\n                            <p class=\"mt-2 text-[12px] leading-5 text-[#F5F1E8]/62 max-w-[500px]\" data-kid=\"1-2-4-1-2-1-4-3\">\n                                Add make, model, registration details and your preferred leather colour, stitch pattern, or fitting requirements.\n                            </p>\n                        </div>\n                        <div class=\"rr-route-step relative pl-20 py-5 border-y border-[#F5F1E8]/16\" data-kid=\"1-2-4-1-2-1-5\">\n                            <span class=\"absolute left-0 top-4 w-[68px] h-[68px] bg-[#D6A62E] grid place-items-center text-[22px] font-black text-[#073B32] rr-tabular\" data-kid=\"1-2-4-1-2-1-5-1\">\n                                04\n                            </span>\n                            <h3 class=\"text-[19px] font-bold\" data-kid=\"1-2-4-1-2-1-5-2\">\n                                Bring it in & we transform it\n                            </h3>\n                            <p class=\"mt-2 text-[12px] leading-5 text-[#F5F1E8]/62 max-w-[500px]\" data-kid=\"1-2-4-1-2-1-5-3\">\n                                Drive to our Nairobi workshop or request mobile fitting. Pay the deposit securely with M-Pesa.\n                            </p>\n                        </div>\n                    </div>\n                    <aside class=\"rr-route-appointment col-span-4 bg-[#052822] p-7 self-end border-l-2 border-[#D6A62E]\" data-kid=\"1-2-4-1-2-2\">\n                        <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold\" data-kid=\"1-2-4-1-2-2-1\">\n                            Step 04 / appointment\n                        </p>\n                        <h3 class=\"mt-4 text-2xl font-black tracking-[-.04em]\" data-kid=\"1-2-4-1-2-2-2\">\n                            Choose a fitting time.\n                        </h3>\n                        <p class=\"mt-3 text-[12px] leading-5 text-[#F5F1E8]/62\" data-kid=\"1-2-4-1-2-2-3\">\n                            Free cancellation up to 24 hours before your appointment. M-Pesa deposit instructions appear before confirmation.\n                        </p>\n                        <button class=\"mt-8 w-full h-12 bg-[#D6A62E] text-[#073B32] text-[11px] font-black tracking-[.1em]\" data-kid=\"1-2-4-1-2-2-4\" type=\"button\">\n                            START BOOKING\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right ml-1\" data-kid=\"1-2-4-1-2-2-4-1\">\n                            </i>\n                        </button>\n                    </aside>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#F5F1E8] text-[#073B32] px-5 lg:px-12 pt-24 pb-28 rr-paper rr-noise\" data-kid=\"1-2-5\" id=\"portfolio-section\">\n            <div class=\"max-w-[1280px] mx-auto\" data-kid=\"1-2-5-1\">\n                <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-8 mb-10\" data-kid=\"1-2-5-1-1\">\n                    <div data-kid=\"1-2-5-1-1-1\">\n                        <p class=\"text-[11px] font-bold tracking-[.18em] uppercase text-[#073B32]/55\" data-kid=\"1-2-5-1-1-1-1\">\n                            05 / Inspection evidence\n                        </p>\n                        <h2 class=\"mt-4 text-[3.35rem] leading-none tracking-[-.07em] font-black\" data-kid=\"1-2-5-1-1-1-2\">\n                            See the workmanship.\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[430px] text-[13px] leading-6 text-[#073B32]/65\" data-kid=\"1-2-5-1-1-2\">\n                        Real transformations from Nairobi, Mombasa Road, Karen, and beyond. Compare the cabin before you browse the full work file.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-x-6 gap-y-3 border-y border-[#073B32]/20 py-4 mb-8 text-[11px] font-bold\" data-kid=\"1-2-5-1-2\">\n                    <button class=\"rr-filter is-active pb-1\" data-kid=\"1-2-5-1-2-1\" type=\"button\">\n                        All work\n                    </button>\n                    <button class=\"rr-filter pb-1\" data-kid=\"1-2-5-1-2-2\" type=\"button\">\n                        Car interiors\n                    </button>\n                    <button class=\"rr-filter pb-1\" data-kid=\"1-2-5-1-2-3\" type=\"button\">\n                        Seats\n                    </button>\n                    <button class=\"rr-filter pb-1\" data-kid=\"1-2-5-1-2-4\" type=\"button\">\n                        Leather\n                    </button>\n                    <button class=\"rr-filter pb-1\" data-kid=\"1-2-5-1-2-5\" type=\"button\">\n                        Cushions\n                    </button>\n                    <button class=\"rr-filter pb-1\" data-kid=\"1-2-5-1-2-6\" type=\"button\">\n                        Canvas\n                    </button>\n                    <button class=\"rr-filter pb-1\" data-kid=\"1-2-5-1-2-7\" type=\"button\">\n                        Before & after\n                    </button>\n                </div>\n                <div class=\"grid grid-cols-12 gap-7\" data-kid=\"1-2-5-1-3\">\n                    <div class=\"col-span-12\" data-kid=\"1-2-5-1-3-1\">\n                        <div aria-label=\"Before and after comparison\" aria-valuemax=\"100\" aria-valuemin=\"0\" aria-valuenow=\"46\" class=\"relative h-[465px] bg-[#052822] overflow-hidden rr-slider\" data-dynamic=\"true\" data-kid=\"1-2-5-1-3-1-1\" data-name=\"before and after comparison slider\" data-reason=\"slider value updated by interaction\" role=\"slider\" tabindex=\"0\">\n                            <img alt=\"After: custom leather car interior\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"1-2-5-1-3-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/upholstery/upholstery-10.jpg\"/>\n                            <div class=\"absolute inset-y-0 left-0 overflow-hidden\" data-dynamic=\"true\" data-kid=\"1-2-5-1-3-1-1-2\" data-name=\"before image container\" data-reason=\"width updated by script on drag\" style=\"width:46%\">\n                                <img alt=\"