xt-[22px] text-[#D6A62E] rr-tabular\" data-kid=\"1-2-1-1-2-1-2-5-2\">\n                                    KES 18,000\n                                </strong>\n                            </div>\n                            <button class=\"w-full h-14 bg-[#D6A62E] text-[#073B32] font-black text-[12px] tracking-[.12em] hover:bg-[#e0b340]\" data-kid=\"1-2-1-1-2-1-2-6\" type=\"button\">\n                                CHECK AVAILABILITY\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right ml-2\" data-kid=\"1-2-1-1-2-1-2-6-1\">\n                                </i>\n                            </button>\n                        </form>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"rr-paper rr-noise bg-[#F5F1E8] text-[#073B32] px-5 lg:px-12 py-20 lg:py-28\" data-kid=\"1-2-2\" id=\"services-section\">\n            <div class=\"max-w-[1280px] mx-auto\" data-kid=\"1-2-2-1\">\n                <div class=\"flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-12\" data-kid=\"1-2-2-1-1\">\n                    <div data-kid=\"1-2-2-1-1-1\">\n                        <p class=\"text-[11px] font-bold tracking-[.18em] uppercase text-[#0B4035]/65\" data-kid=\"1-2-2-1-1-1-1\">\n                            02 / Services\n                        </p>\n                        <h2 class=\"mt-4 text-[3.25rem] leading-none tracking-[-.065em] font-black\" data-kid=\"1-2-2-1-1-1-2\">\n                            Choose the work.\n                        </h2>\n                    </div>\n                    <div class=\"max-w-[480px] text-[13px] leading-6 text-[#073B32]/68\" data-kid=\"1-2-2-1-1-2\">\n                        From a four-hour steering stitch to a full cabin re-trim, every service starts with a clear estimate and workshop time.\n                    </div>\n                </div>\n                <div class=\"rr-stitch mb-8\" data-kid=\"1-2-2-1-2\">\n              