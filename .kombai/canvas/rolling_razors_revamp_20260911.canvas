      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n  .rr-page{font-family:'Plus Jakarta Sans',sans-serif;background:#F5F1E8;color:#073B32;}\n  .rr-page button,.rr-page a{font-family:inherit;}\n  .rr-display{letter-spacing:-.055em;}\n  .rr-tabular{font-variant-numeric:tabular-nums;}\n  .rr-stitch{border-top:1px dashed rgba(214,166,46,.75);position:relative;}\n  .rr-stitch:after{content:'◆';position:absolute;right:0;top:-10px;color:#D6A62E;font-size:11px;background:#F5F1E8;padding-left:10px;}\n  .rr-stitch-dark:after{background:#073B32;}\n  .rr-paper-rule{border-color:rgba(7,59,50,.18);}\n  .rr-scroll::-webkit-scrollbar{height:4px}.rr-scroll::-webkit-scrollbar-thumb{background:#D6A62E}.rr-scroll::-webkit-scrollbar-track{background:rgba(7,59,50,.12)}\n  .rr-map{background-color:#0B4035;background-image:linear-gradient(rgba(245,241,232,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(245,241,232,.08) 1px,transparent 1px);background-size:44px 44px;position:relative;overflow:hidden}\n  .rr-map:before{content:'';position:absolute;width:130%;height:2px;background:#D6A62E;left:-10%;top:48%;transform:rotate(-18deg);box-shadow:0 20px 0 rgba(214,166,46,.22),0 -26px 0 rgba(214,166,46,.16)}\n  .rr-map:after{content:'';position:absolute;width:2px;height:130%;background:rgba(245,241,232,.28);left:58%;top:-12%;transform:rotate(31deg)}\n  .rr-focus:focus-visible{outline:2px solid #D6A62E;outline-offset:3px}\n</style>\n<div class=\"rr-page min-h-screen\" data-kid=\"1\">\n    <header class=\"bg-[#073B32] text-[#F5F1E8] border-b border-[#D6A62E]/35 sticky top-0 z-20\" data-kid=\"1-1\">\n        <div class=\"max-w-[1260px] mx-auto px-8 h-[78px] flex items-center justify-between\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\">\n                <div class=\"w-10 h-10 border border-[#D6A62E] flex items-center justify-center relative\" data-kid=\"1-1-1-1-1\">\n                    <span class=\"absolute inset-[5px] border border-[#D6A62E]/45 rotate-45\" data-kid=\"1-1-1-1-1-1\">\n                    </span>\n                    <span class=\"text-[#D6A62E] text-lg relative\" data-kid=\"1-1-1-1-1-2\">\n                        ✂\n                    </span>\n                </div>\n                <div class=\"leading-none\" data-kid=\"1-1-1-1-2\">\n                    <div class=\"font-extrabold tracking-[-.04em] text-[18px]\" data-kid=\"1-1-1-1-2-1\">\n                        ROLLING RAZORS\n                        <span class=\"text-[#D6A62E] text-[12px] tracking-[.18em]\" data-kid=\"1-1-1-1-2-1-1\">\n                            CUSTOMS\n                        </span>\n                    </div>\n                    <div class=\"font-signature text-[#D6A62E] text-[15px] mt-1\" data-kid=\"1-1-1-1-2-2\">\n                        “Your Vision, Our Craftsmanship.”\n                    </div>\n                </div>\n            </div>\n            <nav class=\"hidden lg:flex items-center gap-7 text-[12px] font-semibold text-[#F5F1E8]/80\" data-kid=\"1-1-1-2\">\n                <a class=\"text-[#D6A62E]\" data-kid=\"1-1-1-2-1\" href=\"#top\">\n                    Home\n                </a>\n                <a data-kid=\"1-1-1-2-2\" href=\"#services\">\n                    Services\n                </a>\n                <a data-kid=\"1-1-1-2-3\" href=\"#portfolio\">\n                    Our work\n                </a>\n                <a data-kid=\"1-1-1-2-4\" href=\"#standard\">\n                    Our standard\n                </a>\n                <a data-kid=\"1-1-1-2-5\" href=\"#visit\">\n                    Workshop\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-3\">\n                <button class=\"rr-focus hidden sm:block px-3 py-2 border border-[#F5F1E8]/20 text-[11px] font-bold\" data-kid=\"1-1-1-3-1\">\n                    Driver sign in\n                </button>\n                <button class=\"rr-focus bg-[#D6A62E] text-[#073B32] px-4 py-2.5 text-[11px] font-extrabold tracking-[.08em]\" data-kid=\"1-1-1-3-2\">\n                    BOOK A FITTING\n                    <span class=\"ml-2\" data-kid=\"1-1-1-3-2-1\">\n                        →\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"bg-[#073B32] text-[#F5F1E8] min-h-[650px] relative overflow-hidden\" data-kid=\"1-2-1\">\n            <div class=\"absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_70%_20%,rgba(214,166,46,.28),transparent_34%)]\" data-kid=\"1-2-1-1\">\n            </div>\n            <div class=\"max-w-[1260px] mx-auto px-8 py-14 grid grid-cols-12 gap-10 items-center relative\" data-kid=\"1-2-1-2\">\n                <div class=\"col-span-7\" data-kid=\"1-2-1-2-1\">\n                    <div class=\"grid grid-cols-[1.08fr_.92fr] gap-8 items-end\" data-kid=\"1-2-1-2-1-1\">\n                        <div data-kid=\"1-2-1-2-1-1-1\">\n                            <div class=\"text-[#D6A62E] text-[11px] font-bold tracking-[.2em] uppercase mb-8\" data-kid=\"1-2-1-2-1-1-1-1\">\n                                Nairobi · Industrial Area · Since 2019\n                            </div>\n                            <h1 class=\"rr-display text-[76px] leading-[.94] font-extrabold max-w-[590px]\" data-kid=\"1-2-1-2-1-1-1-2\">\n                                Interiors made\n                                <br data-kid=\"1-2-1-2-1-1-1-2-1\"/>\n                                <span class=\"text-[#D6A62E]\" data-kid=\"1-2-1-2-1-1-1-2-2\">\n                                    to fit.\n                                </span>\n                            </h1>\n                            <p class=\"mt-7 max-w-[510px] text-[16px] leading-7 text-[#F5F1E8]/75\" data-kid=\"1-2-1-2-1-1-1-3\">\n                                Choose the service, vehicle and fitting time. Starting prices are shown before you book.\n                            </p>\n                            <div class=\"mt-9 flex items-center gap-5\" data-kid=\"1-2-1-2-1-1-1-4\">\n                                <button class=\"rr-focus bg-[#D6A62E] text-[#073B32] px-6 py-4 text-[12px] font-extrabold tracking-[.08em]\" data-kid=\"1-2-1-2-1-1-1-4-1\">\n                                    CHECK AVAILABILITY\n                                    <span class=\"ml-3\" data-kid=\"1-2-1-2-1-1-1-4-1-1\">\n                                        →\n                                    </span>\n                                </button>\n                                <a class=\"text-[12px] font-bold text-[#F5F1E8] border-b border-[#D6A62E] pb-1\" data-kid=\"1-2-1-2-1-1-1-4-2\" href=\"#services\">\n                                    Browse services\n                                </a>\n                            </div>\n                            <div class=\"mt-12 rr-stitch rr-stitch-dark pt-5 flex items-center gap-8 text-[11px] text-[#F5F1E8]/70\" data-kid=\"1-2-1-2-1-1-1-5\">\n                                <span data-kid=\"1-2-1-2-1-1-1-5-1\">\n                                    <strong class=\"text-[#D6A62E] text-[20px] rr-tabular\" data-kid=\"1-2-1-2-1-1-1-5-1-1\">\n                                        4.9/5\n                                    </strong>\n                                    from drivers\n                                </span>\n                                <span data-kid=\"1-2-1-2-1-1-1-5-2\">\n                                    850+ rides transformed\n                                </span>\n                                <span class=\"text-[#D6A62E]\" data-kid=\"1-2-1-2-1-1-1-5-3\">\n                                    M-Pesa deposits accepted\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"h-[360px] relative overflow-hidden border border-[#F5F1E8]/15\" data-kid=\"1-2-1-2-1-1-2\">\n                            <img alt=\"Handcrafted automotive interior\" class=\"w-full h-full object-cover\" data-kid=\"1-2-1-2-1-1-2-1\" decoding=\"async\" loading=\"eager\" src=\"/api/local/images/public/images/upholstery/upholstery-01.jpg\"/>\n                            <div class=\"absolute inset-0 bg-gradient-to-t from-[#073B32]/80 via-transparent to-[#073B32]/10\" data-kid=\"1-2-1-2-1-1-2-2\">\n                            </div>\n                            <div class=\"absolute bottom-4 left-4 text-[11px] text-[#F5F1E8]/80\" data-kid=\"1-2-1-2-1-1-2-3\">\n                                <span class=\"text-[#D6A62E] font-bold\" data-kid=\"1-2-1-2-1-1-2-3-1\">\n                                    01 / 09\n                                </span>\n                                <br data-kid=\"1-2-1-2-1-1-2-3-2\"/>\n                                Seat work · before the first stitch\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-span-5\" data-kid=\"1-2-1-2-2\">\n                    <div class=\"bg-[#F5F1E8] text-[#073B32] p-7 border-l-4 border-[#D6A62E] relative\" data-kid=\"1-2-1-2-2-1\">\n                        <div class=\"absolute top-0 right-0 bg-[#D6A62E] text-[#073B32] px-3 py-2 text-[10px] font-extrabold tracking-[.1em]\" data-kid=\"1-2-1-2-2-1-1\">\n                            M-PESA SUPPORTED\n                        </div>\n                        <div class=\"pt-5 pb-5 border-b border-[#073B32]/15\" data-kid=\"1-2-1-2-2-1-2\">\n                            <div class=\"text-[11px] font-extrabold tracking-[.16em] uppercase\" data-kid=\"1-2-1-2-2-1-2-1\">\n                                Request a fitting time\n                            </div>\n                            <div class=\"mt-1 text-[13px] text-[#073B32]/60\" data-kid=\"1-2-1-2-2-1-2-2\">\n                                No payment is taken on this first request.\n                            </div>\n                        </div>\n                        <form class=\"pt-5 space-y-4\" data-kid=\"1-2-1-2-2-1-3\">\n                            <label class=\"block text-[10px] font-extrabold tracking-[.15em] uppercase\" data-kid=\"1-2-1-2-2-1-3-1\">\n                                01 · Choose a service\n                                <select class=\"rr-focus mt-2 w-full border border-[#073B32]/25 bg-transparent px-3 py-3 text-[12px] font-semibold\" data-kid=\"1-2-1-2-2-1-3-1-1\" data-name=\"service selection dropdown\">\n                                    <option data-kid=\"1-2-1-2-2-1-3-1-1-1\">\n                                        Car Upholstery · from KES 18,000\n                                    </option>\n                                    <option data-kid=\"1-2-1-2-2-1-3-1-1-2\">\n                                        Custom Car Seats · from KES 14,500\n                                    </option>\n                                    <option data-kid=\"1-2-1-2-2-1-3-1-1-3\">\n                                        Leather Work & Stitching · from KES 22,000\n                                    </option>\n                                </select>\n                            </label>\n                            <div data-kid=\"1-2-1-2-2-1-3-2\">\n                                <div class=\"text-[10px] font-extrabold tracking-[.15em] uppercase mb-2\" data-kid=\"1-2-1-2-2-1-3-2-1\">\n                                    02 · Vehicle type\n                                </div>\n                                <div class=\"grid grid-cols-3 gap-1.5\" data-kid=\"1-2-1-2-2-1-3-2-2\" data-name=\"vehicle type selection buttons\">\n                                    <button class=\"rr-focus py-2.5 text-[11px] font-bold border bg-[#073B32] text-[#F5F1E8] border-[#073B32]\" data-kid=\"1-2-1-2-2-1-3-2-2-1\" type=\"button\">\n                                        Car\n                                    </button>\n                                    <button class=\"rr-focus py-2.5 text-[11px] font-bold border border-[#073B32]/20 text-[#073B32]/65\" data-kid=\"1-2-1-2-2-1-3-2-2-2\" type=\"button\">\n                                        SUV\n                                    </button>\n                                    <button class=\"rr-focus py-2.5 text-[11px] font-bold border border-[#073B32]/20 text-[#073B32]/65\" data-kid=\"1-2-1-2-2-1-3-2-2-3\" type=\"button\">\n                                        Van\n                                    </button>\n                                    <button class=\"rr-focus py-2.5 text-[11px] font-bold border border-[#073B32]/20 text-[#073B32]/65\" data-kid=\"1-2-1-2-2-1-3-2-2-4\" type=\"button\">\n                                        Truck\n                                    </button>\n                                    <button class=\"rr-focus py-2.5 text-[11px] font-bold border border-[#073B32]/20 text-[#073B32]/65\" data-kid=\"1-2-1-2-2-1-3-2-2-5\" type=\"button\">\n                                        Matatu\n                                    </button>\n                                    <button class=\"rr-focus py-2.5 text-[11px] font-bold border border-[#073B32]/20 text-[#073B32]/65\" data-kid=\"1-2-1-2-2-1-3-2-2-6\" type=\"button\">\n                                        Other\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-3\" data-kid=\"1-2-1-2-2-1-3-3\">\n                                <label class=\"block text-[10px] font-extrabold tracking-[.15em] uppercase\" data-kid=\"1-2-1-2-2-1-3-3-1\">\n                                    03 · Preferred date\n                                    <input class=\"rr-focus mt-2 w-full border border-[#073B32]/25 bg-transparent px-3 py-3 text-[12px] font-semibold\" data-kid=\"1-2-1-2-2-1-3-3-1-1\" data-name=\"preferred date input\" readonly=\"\" type=\"text\" value=\"12 Sep 2026\"/>\n                                </label>\n                                <label class=\"block text-[10px] font-extrabold tracking-[.15em] uppercase\" data-kid=\"1-2-1-2-2-1-3-3-2\">\n                                    Time\n                                    <select class=\"rr-focus mt-2 w-full border border-[#073B32]/25 bg-transparent px-3 py-3 text-[12px] font-semibold\" data-kid=\"1-2-1-2-2-1-3-3-2-1\" data-name=\"preferred time selection dropdown\">\n                                        <option data-kid=\"1-2-1-2-2-1-3-3-2-1-1\">\n                                            10:00 AM – 12:00 PM\n                                        </option>\n                                        <option data-kid=\"1-2-1-2-2-1-3-3-2-1-2\">\n                                            1:00 PM – 3:00 PM\n                                        </option>\n                                    </select>\n                                </label>\n                            </div>\n                            <div data-kid=\"1-2-1-2-2-1-3-4\">\n                                <div class=\"text-[10px] font-extrabold tracking-[.15em] uppercase mb-2\" data-kid=\"1-2-1-2-2-1-3-4-1\">\n                                    04 · Fitting location\n                                </div>\n                                <div class=\"grid grid-cols-2 gap-2\" data-kid=\"1-2-1-2-2-1-3-4-2\">\n                                    <button class=\"rr-focus border-2 border-[#D6A62E] bg-[#073B32] text-[#F5F1E8] p-3 text-left text-[11px] font-bold\" data-kid=\"1-2-1-2-2-1-3-4-2-1\" type=\"button\">\n                                        ● Workshop\n                                        <br data-kid=\"1-2-1-2-2-1-3-4-2-1-1\"/>\n                                        <span class=\"text-[10px] font-normal text-[#F5F1E8]/60\" data-kid=\"1-2-1-2-2-1-3-4-2-1-2\">\n                                            Industrial Area\n                                        </span>\n                                    </button>\n                                    <button class=\"rr-focus border border-[#073B32]/20 p-3 text-left text-[11px] font-bold\" data-kid=\"1-2-1-2-2-1-3-4-2-2\" type=\"button\">\n                                        ○ Mobile fit\n                                        <br data-kid=\"1-2-1-2-2-1-3-4-2-2-1\"/>\n                                        <span class=\"text-[10px] font-normal text-[#073B32]/55\" data-kid=\"1-2-1-2-2-1-3-4-2-2-2\">\n                                            Your location\n                                        </span>\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"bg-[#073B32] text-[#F5F1E8] px-4 py-3 flex justify-between items-center\" data-kid=\"1-2-1-2-2-1-3-5\">\n                                <span class=\"text-[11px] text-[#F5F1E8]/65\" data-kid=\"1-2-1-2-2-1-3-5-1\">\n                                    Starting estimate\n                                </span>\n                                <strong class=\"text-[#D6A62E] text-[19px] rr-tabular\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1-3-5-2\" data-name=\"starting estimate price display\" data-reason=\"price updated dynamically by form selection\">\n                                    KES 18,000\n                                </strong>\n                            </div>\n                            <button class=\"rr-focus w-full bg-[#D6A62E] py-4 text-[11px] font-extrabold tracking-[.1em]\" data-kid=\"1-2-1-2-2-1-3-6\" type=\"button\">\n                                CHECK AVAILABILITY\n                                <span class=\"ml-2\" data-kid=\"1-2-1-2-2-1-3-6-1\">\n                                    →\n                                </span>\n                            </button>\n       