32]/18 flex items-end justify-between\" data-kid=\"1-2-2-2-5-1-2-2-4\">\n                                    <div data-kid=\"1-2-2-2-5-1-2-2-4-1\">\n                                        <strong class=\"block text-[12px]\" data-kid=\"1-2-2-2-5-1-2-2-4-1-1\">\n                                            Kiprono Cheruiyot\n                                        </strong>\n                                        <span class=\"block mt-1 text-[11px] text-[#073B32]/58\" data-kid=\"1-2-2-2-5-1-2-2-4-1-2\">\n                                            Land Cruiser Prado TX · Custom leather seats\n                                        </span>\n                                        <span class=\"block mt-1 text-[11px] text-[#073B32]/58\" data-kid=\"1-2-2-2-5-1-2-2-4-1-3\">\n                                            Eldoret, Kenya · July 2026\n                                        </span>\n                                    </div>\n                                    <span class=\"text-[12px] font-black text-[#D6A62E]\" data-kid=\"1-2-2-2-5-1-2-2-4-2\">\n                                        ★★★★★\n                                    </span>\n                                </div>\n                                <div class=\"mt-5 text-[10px] font-bold text-[#0B4035] flex items-center gap-1\" data-kid=\"1-2-2-2-5-1-2-2-5\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-rosette-discount-check\" data-kid=\"1-2-2-2-5-1-2-2-5-1\">\n                                    </i>\n                                    Verified booking\n                                </div>\n                            </aside>\n                        </div>\n                    </div>\n                </section>\n                <section class=\"bg-[#0B4035] text-[#F5F1E8] px-5 lg:px-12 py-24 lg:py-28\" data-kid=\"1-2-2-2-6\" id=\"arrival-section\">\n                    <div class=\"max-w-[1280px] mx-auto\" data-kid=\"1-2-2-2-6-1\">\n                        <div class=\"flex flex-col lg:flex-row justify-between gap-8 mb-12\" data-kid=\"1-2-2-2-6-1-1\">\n                            <div data-kid=\"1-2-2-2-6-1-1-1\">\n                                <p class=\"text-[11px] font-bold tracking-[.18em] uppercase text-[#D6A62E]\" data-kid=\"1-2-2-2-6-1-1-1-1\">\n                                    07 / Arrival board\n                                </p>\n                                <h2 class=\"mt-4 text-[3.15rem] leading-none tracking-[-.065em] font-black\" data-kid=\"1-2-2-2-6-1-1-1-2\">\n                                    Find the workshop.\n                                </h2>\n                            </div>\n                            <p class=\"max-w-[400px] text-[13px] leading-6 text-[#F5F1E8]/62\" data-kid=\"1-2-2-2-6-1-1-2\">\n                                Bring your vehicle for a material inspection, a leather swatch review, or a sit-down ergonomics consultation.\n                            </p>\n                        </div>\n                        <div class=\"rr-14 border border-[#D6A62E]/40\" data-kid=\"1-2-2-2-6-1-2\">\n                            <div class=\"rr-span-9 rr-map min-h-[450px] bg-[#052822] relative\" data-kid=\"1-2-2-2-6-1-2-1\">\n                                <iframe class=\"absolute inset-0 w-full h-full border-0\" data-kid=\"1-2-2-2-6-1-2-1-1\" loading=\"lazy\" src=\"https://www.google.com/maps?q=-1.3098,36.8524&z=16&hl=en&output=embed\" title=\"Rolling Razors Customs workshop map\">\n                                </iframe>\n                                <div class=\"absolute left-5 top-5 z-10 bg-[#073B32]/92 px-4 py-3 border-l-2 border-[#D6A62E] text-[#F5F1E8] pointer-events-none\" data-kid=\"1-2-2-2-6-1-2-1-2\">\n                                    <span class=\"block text-[10px] uppercase tracking-[.15em] text-[#D6A62E] font-bold\" data-kid=\"1-2-2-2-6-1-2-1-2-1\">\n                                        Workshop coordinates\n                                    </span>\n                                    <span class=\"block mt-1 text-[12px] font-bold\" data-kid=\"1-2-2-2-6-1-2-1-2-2\">\n                                        Industrial Area · Nairobi\n                                    </span>\n                                    <span class=\"block mt-1 text-[10px] text-[#F5F1E8]/58\" data-kid=\"1-2-2-2-6-1-2-1-2-3\">\n                                        -1.3098, 36.8524\n                                    </span>\n                                </div>\n                                <a class=\"absolute right-5 bottom-5 z-10 h-12 px-5 bg-[#D6A62E] text-[#073B32] text-[11px] font-black tracking-[.08em] flex items-center gap-2\" data-kid=\"1-2-2-2-6-1-2-1-3\" href=\"https://maps.google.com/?q=-1.3098,36.8524+(Rolling+Razors+Customs)\">\n                                    GET DIRECTIONS\n                                    <i aria-hidden=\"true\" class=\"ti ti-navigation\" data-kid=\"1-2-2-2-6-1-2-1-3-1\">\n                                    </i>\n                                </a>\n                            </div>\n                            <div class=\"rr-span-5 bg-[#073B32] p-8 lg:p-10\" data-kid=\"1-2-2-2-6-1-2-2\">\n                                <div class=\"pb-7 border-b border-[#F5F1E8]/18\" data-kid=\"1-2-2-2-6-1-2-2-1\">\n                                    <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold\" data-kid=\"1-2-2-2-6-1-2-2-1-1\">\n                                        Rolling Razors Customs workshop\n                                    </p>\n                                    <h3 class=\"mt-3 text-xl font-bold\" data-kid=\"1-2-2-2-6-1-2-2-1-2\">\n                                        Enterprise Road / Off Commercial Street\n                                    </h3>\n                                    <p class=\"mt-2 text-[12px] leading-5 text-[#F5F1E8]/62\" data-kid=\"1-2-2-2-6-1-2-2-1-3\">\n                                        Industrial Area, Nairobi, Kenya\n                                        <br data-kid=\"1-2-2-2-6-1-2-2-1-3-1\"/>\n                                        Close to Mombasa Road & Southern Bypass Interchange\n                                    </p>\n                                </div>\n                                <div class=\"pt-7\" data-kid=\"1-2-2-2-6-1-2-2-2\">\n                                    <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold mb-4\" data-kid=\"1-2-2-2-6-1-2-2-2-1\">\n                                        Workshop hours\n                                    </p>\n                                    <table class=\"rr-contact-table w-full text-[12px] rr-tabular\" data-kid=\"1-2-2-2-6-1-2-2-2-2\">\n                                        <tbody data-kid=\"1-2-2-2-6-1-2-2-2-2-1\">\n                                            <tr data-kid=\"1-2-2-2-6-1-2-2-2-2-1-1\">\n                                                <td class=\"py-3 text-[#F5F1E8]/68\" data-kid=\"1-2-2-2-6-1-2-2-2-2-1-1-1\">\n                                                    Monday – Friday\n                                                </td>\n                                                <td class=\"py-3 text-right font-bold\" data-kid=\"1-2-2-2-6-1-2-2-2-2-1-1-2\">\n                                                    8:00 AM – 6:00 PM\n                                                </td>\n                                            </tr>\n                                            <tr data-kid=\"1-2-2-2-6-1-2-2-2-2-1-2\">\n                                                <td class=\"py-3 text-[#F5F1E8]/68\" data-kid=\"1-2-2-2-6-1-2-2-2-2-1-2-1\">\n                                                    Saturday\n                                                </td>\n                                                <td class=\"py-3 text-right font-bold\" data-kid=\"1-2-2-2-6-1-2-2-2-2-1-2-2\">\n                                                    8:00 AM – 6:00 PM\n                                                </td>\n                                            </tr>\n                                            <tr data-kid=\"1-2-2-2-6-1-2-2-2-2-1-3\">\n                                                <td class=\"py-3 text-[#F5F1E8]/68\" data-kid=\"1-2-2-2-6-1-2-2-2-2-1-3-1\">\n                                                    Sunday\n                                                </td>\n                                                <td class=\"py-3 text-right font-bold text-[#D6A62E]\" data-kid=\"1-2-2-2-6-1-2-2-2-2-1-3-2\">\n                                                    Special appointments\n                                                </td>\n                                            </tr>\n                                        </tbody>\n                                    </table>\n                                </div>\n                                <div class=\"grid grid-cols-2 gap-3 mt-8\" data-kid=\"1-2-2-2-6-1-2-2-3\">\n                                    <a class=\"h-12 border border-[#D6A62E] text-[#F5F1E8] flex items-center justify-center gap-2 text-[11px] font-bold\" data-kid=\"1-2-2-2-6-1-2-2-3-1\" href=\"tel:+254712345678\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"1-2-2-2-6-1-2-2-3-1-1\">\n                                        </i>\n                                        CALL 0712 345 678\n                                    </a>\n                                    <a class=\"h-12 bg-[#25D366] text-white flex items-center justify-center gap-2 text-[11px] font-black\" data-kid=\"1-2-2-2-6-1-2-2-3-2\" href=\"https://wa.me/254712345678\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-brand-whatsapp\" data-kid=\"1-2-2-2-6-1-2-2-3-2-1\">\n                                        </i>\n                                        WHATSAPP\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </main>\n    <footer class=\"bg-[#052822] text-[#F5F1E8] px-5 lg:px-12 py-14 border-t border-[#D6A62E]/25\" data-kid=\"1-3\">\n        <div class=\"rr-footer-grid max-w-[1280px] mx-auto grid grid-cols-12 gap-10\" data-kid=\"1-3-1\">\n            <div class=\"col-span-5\" data-kid=\"1-3-1-1\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1\">\n                    <span class=\"w-9 h-9 border border-[#D6A62E]/70 bg-[#073B32] grid place-items-center text-[#D6A62E]\" data-kid=\"1-3-1-1-1-1\">\n                        <i aria-hidden=\"true\" class=\"ti ti-scissors text-lg\" data-kid=\"1-3-1-1-1-1-1\">\n                        </i>\n                    </span>\n                    <span class=\"font-black tracking-[-.03em]\" data-kid=\"1-3-1-1-1-2\">\n                        ROLLING RAZORS\n                        <b class=\"text-[10px] tracking-[.15em] text-[#D6A62E]\" data-kid=\"1-3-1-1-1-2-1\">\n                            CUSTOMS\n                        </b>\n                    </span>\n                </div>\n                <p class=\"mt-5 max-w-[340px] text-[12px] leading-5 text-[#F5F1E8]/58\" data-kid=\"1-3-1-1-2\">\n                    Automotive upholstery, custom seats, leather work, cushions, canvas, and vehicle interiors in Nairobi.\n                </p>\n                <p class=\"rr-signature mt-5 text-[#D6A62E] text-[19px]\" data-kid=\"1-3-1-1-3\">\n                    Your Vision, Our Craftsmanship.\n                </p>\n            </div>\n            <div class=\"col-span-2\" data-kid=\"1-3-1-2\">\n                <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold\" data-kid=\"1-3-1-2-1\">\n                    Explore\n                </p>\n                <div class=\"mt-4 space-y-3 text-[12px] text-[#F5F1E8]/65\" data-kid=\"1-3-1-2-2\">\n                    <a class=\"block hover:text-[#D6A62E]\" data-kid=\"1-3-1-2-2-1\" href=\"#services-section\">\n                        Services\n                    </a>\n                    <a class=\"block hover:text-[#D6A62E]\" data-kid=\"1-3-1-2-2-2\" href=\"#spec-section\">\n                        Build spec\n                    </a>\n                    <a class=\"block hover:text-[#D6A62E]\" data-kid=\"1-3-1-2-2-3\" href=\"#portfolio-section\">\n                        Our work\n                    </a>\n                    <a class=\"block hover:text-[#D6A62E]\" data-kid=\"1-3-1-2-2-4\" href=\"#arrival-section\">\n                        Workshop\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-span-3\" data-kid=\"1-3-1-3\">\n                <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold\" data-kid=\"1-3-1-3-1\">\n                    Popular work\n                </p>\n                <div class=\"mt-4 space-y-3 text-[12px] text-[#F5F1E8]/65\" data-kid=\"1-3-1-3-2\">\n                    <span class=\"block\" data-kid=\"1-3-1-3-2-1\">\n                        Car Upholstery\n                    </span>\n                    <span class=\"block\" data-kid=\"1-3-1-3-2-2\">\n                        Custom Car Seats\n                    </span>\n                    <span class=\"block\" data-kid=\"1-3-1-3-2-3\">\n                        Leather Work & Stitching\n                    </span>\n                    <span class=\"block\" data-kid=\"1-3-1-3-2-4\">\n                        Steering Wheel Stitching\n                    </span>\n                </div>\n            </div>\n            <div class=\"col-span-2\" data-kid=\"1-3-1-4\">\n                <p class=\"text-[10px] uppercase tracking-[.16em] text-[#D6A62E] font-bold\" data-kid=\"1-3-1-4-1\">\n                    Connect\n                </p>\n                <p class=\"mt-4 text-[12px] text-[#F5F1E8]/65\" data-kid=\"1-3-1-4-2\">\n                    0712 345 678\n                    <br data-kid=\"1-3-1-4-2-1\"/>\n                    info@rollingrazors.co.ke\n                </p>\n                <div class=\"mt-5 flex gap-3 text-[#F5F1E8]/75 text-lg\" data-kid=\"1-3-1-4-3\">\n                    <a aria-label=\"Facebook\" data-kid=\"1-3-1-4-3-1\" href=\"https://facebook.com/rollingrazorskenya\" rel=\"noreferrer\" target=\"_blank\">\n                        <i class=\"ti ti-brand-facebook\" data-kid=\"1-3-1-4-3-1-1\">\n                        </i>\n                    </a>\n                    <a aria-label=\"Instagram\" data-kid=\"1-3-1-4-3-2\" href=\"https://instagram.com/rollingrazorscustoms\" rel=\"noreferrer\" target=\"_blank\">\n                        <i class=\"ti ti-brand-instagram\" data-kid=\"1-3-1-4-3-2-1\">\n                        </i>\n                    </a>\n                    <a aria-label=\"TikTok\" data-kid=\"1-3-1-4-3-3\" href=\"https://tiktok.com/@rollingrazorscustoms\" rel=\"noreferrer\" target=\"_blank\">\n                        <i class=\"ti ti-brand-tiktok\" data-kid=\"1-3-1-4-3-3-1\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div class=\"max-w-[1280px] mx-auto mt-12 pt-5 border-t border-[#F5F1E8]/12 flex flex-col sm:flex-row justify-between gap-3 text-[10px] text-[#F5F1E8]/42\" data-kid=\"1-3-2\">\n            <span data-kid=\"1-3-2-1\">\n                © 2026 Rolling Razors Customs Kenya Limited · Nairobi, Kenya\n            </span>\n            <span data-kid=\"1-3-2-2\">\n                Privacy · Terms · Refund policy\n            </span>\n        </div>\n    </footer>\n    <script>\n        (() => {\n      const rows=[...document.querySelectorAll('.rr-service-row')]; const img=document.getElementById('service-board-image'); const title=document.getElementById('service-board-title'); const price=document.getElementById('service-board-price'); const time=document.getElementById('service-board-time'); const desc=document.querySelector('#service-board-title + p');\n      rows.forEach(row=>row.addEventListener('click',()=>{ rows.forEach(r=>r.classList.remove('is-active')); row.classList.add('is-active'); img.src=row.dataset.image; title.textContent=row.dataset.service; price.textContent=row.dataset.price; time.textContent=row.dataset.time; if(desc) desc.textContent=row.dataset.desc; }));\n      let material='Nappa leather',color='Saddle brown & black',pattern='Diamond quilted'; const syncSpec=()=>{const node=document.getElementById('spec-summary'); if(node) node.innerHTML=material+' <span class=\"text-[#D6A62E]\">·</span> '+color+' <span class=\"text-[#D6A62E]\">·</span> '+pattern;};\n      document.querySelectorAll('.rr-material').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.rr-material').forEach(b=>b.classList.remove('is-active'));btn.classList.add('is-active');material=btn.dataset.spec;const preview=document.getElementById('spec-image');if(preview)preview.src=btn.dataset.specImage;syncSpec();}));\n      document.querySelectorAll('.rr-swatch').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.rr-swatch').forEach(b=>b.classList.remove('is-active'));btn.classList.add('is-active');color=btn.dataset.color;syncSpec();}));\n      document.querySelectorAll('.rr-pattern').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.rr-pattern').forEach(b=>b.classList.remove('is-active'));btn.classList.add('is-active');pattern=btn.dataset.pattern;syncSpec();}));\n      document.querySelectorAll('.rr-filter').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.rr-filter').forEach(b=>b.classList.remove('is-active'));btn.classList.add('is-active');}));\n      const slider=document.querySelector('.rr-slider'); if(slider){const set=x=>{const rect=slider.getBoundingClientRect();const pct=Math.max(3,Math.min(97,((x-rect.left)/rect.width)*100));const before=slider.querySelector('div.absolute.inset-y-0');const seam=slider.querySelector('div.absolute.top-0');if(before)before.style.width=pct+'%';if(seam)seam.style.left=pct+'%';slider.setAttribute('aria-valuenow',Math.round(pct));};slider.addEventListener('pointermove',e=>{if(e.buttons)set(e.clientX);});slider.addEventListener('pointerdown',e=>{slider.setPointerCapture(e.pointerId);set(e.clientX);});slider.addEventListener('keydown',e=>{const current=Number(slider.getAttribute('aria-valuenow')||46);if(e.key==='ArrowLeft')set(slider.getBoundingClientRect().left+slider.getBoundingClientRect().width*((current-5)/100));if(e.key==='ArrowRight')set(slider.getBoundingClientRect().left+slider.getBoundingClientRect().width*((current+5)/100));});}\n      const railLinks=[...document.querySelectorAll('[data-rail-target]')]; const tracked=railLinks.map(link=>document.getElementById(link.dataset.railTarget)).filter(Boolean); if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){railLinks.forEach(link=>link.classList.toggle('is-current',link.dataset.railTarget===entry.target.id));}});},{rootMargin:'-25% 0px -65% 0px',threshold:0});tracked.forEach(section=>observer.observe(section));}\n    })();\n    </script>\n</div>\n",
