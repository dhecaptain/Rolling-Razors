-step:nth-child(4){border-bottom:0}.rr-step:nth-child(4){border-right:0}}\n</style>\n<div class=\"rr-page\" data-kid=\"1\">\n    <header class=\"rr-nav\" data-kid=\"1-1\">\n        <div class=\"rr-brand\" data-kid=\"1-1-1\">\n            <div class=\"rr-brand-mark\" data-kid=\"1-1-1-1\">\n                <span data-kid=\"1-1-1-1-1\">\n                </span>\n            </div>\n            <div class=\"rr-brand-copy\" data-kid=\"1-1-1-2\">\n                <strong data-kid=\"1-1-1-2-1\">\n                    ROLLING RAZORS\n                    <em data-kid=\"1-1-1-2-1-1\">\n                        CUSTOMS\n                    </em>\n                </strong>\n                <span class=\"rr-tagline\" data-kid=\"1-1-1-2-2\">\n                    “Your Vision, Our Craftsmanship.”\n                </span>\n            </div>\n        </div>\n        <nav class=\"rr-nav-links\" data-kid=\"1-1-2\">\n            <a data-kid=\"1-1-2-1\" href=\"#top\">\n                Home\n            </a>\n            <a data-kid=\"1-1-2-2\" href=\"#services\">\n                Services\n            </a>\n            <a data-kid=\"1-1-2-3\" href=\"#work\">\n                Our work\n            </a>\n            <a data-kid=\"1-1-2-4\" href=\"#proof\">\n                About us\n            </a>\n            <a data-kid=\"1-1-2-5\" href=\"#booking-route\">\n                How it works\n            </a>\n            <a data-kid=\"1-1-2-6\" href=\"#visit\">\n                Contact\n            </a>\n        </nav>\n        <div class=\"rr-nav-actions\" data-kid=\"1-1-3\">\n            <a data-kid=\"1-1-3-1\" href=\"#\">\n                Driver sign in\n            </a>\n            <button class=\"rr-btn rr-btn-gold\" data-kid=\"1-1-3-2\">\n                Book a fitting\n                <span data-kid=\"1-1-3-2-1\">\n                    →\n                </span>\n            </button>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"rr-hero\" data-kid=\"1-2-1\">\n            <div class=\"rr-hero-visual\" data-kid=\"1-2-1-1\">\n                <div class=\"rr-hero-copy\" data-kid=\"1-2-1-1-1\">\n                    <div class=\"eyebrow\" data-kid=\"1-2-1-1-1-1\">\n                        Nairobi workshop · custom vehicle interiors\n                    </div>\n                    <h1 data-kid=\"1-2-1-1-1-2\">\n                        Interiors made to fit.\n                        <span data-kid=\"1-2-1-1-1-2-1\">\n                            Made for your vehicle.\n                        </span>\n                    </h1>\n                    <p data-kid=\"1-2-1-1-1-3\">\n                        Choose the service, vehicle and fitting time. Starting prices are shown before you book.\n                    </p>\n                    <div data-kid=\"1-2-1-1-1-4\">\n                        <button class=\"rr-btn rr-btn-gold\" data-kid=\"1-2-1-1-1-4-1\">\n                            Start a fitting request\n                            <span data-kid=\"1-2-1-1-1-4-1-1\">\n                                →\n                            </span>\n                        </button>\n                        <a data-kid=\"1-2-1-1-1-4-2\" href=\"#services\" style=\"color:var(--ivory);font-size:12px;font-weight:800;text-decoration:underline;text-underline-offset:5px;margin-left:20px\">\n                            Browse services\n                        </a>\n                    </div>\n                    <div class=\"rr-hero-proof\" data-kid=\"1-2-1-1-1-5\">\n                        <span class=\"rr-proof-dot\" data-kid=\"1-2-1-1-1-5-1\">\n                        </span>\n                        <b data-dynamic=\"true\" data-kid=\"1-2-1-1-1-5-2\" data-name=\"transform count statistic\" data-reason=\"number text fetched or calculated by script\">\n                            4.9/5\n                        </b>\n                        <span data-kid=\"1-2-1-1-1-5-3\">\n                            from Kenyan drivers\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-5-4\">\n                            ·\n                        </span>\n                        <b data-dynamic=\"true\" data-kid=\"1-2-1-1-1-5-5\" data-name=\"ride count statistic\" data-reason=\"number text fetched or calculated by script\">\n                            850+\n                        </b>\n                        <span data-kid=\"1-2-1-1-1-5-6\">\n                            rides transformed\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <aside class=\"rr-appointment\" data-kid=\"1-2-1-2\">\n                <h2 data-kid=\"1-2-1-2-1\">\n                    Request a fitting time\n                </h2>\n                <p class=\"sub\" data-kid=\"1-2-1-2-2\">\n                    Select the work, vehicle and visit details.\n                </p>\n                <form data-kid=\"1-2-1-2-3\">\n                    <div class=\"rr-field\" data-kid=\"1-2-1-2-3-1\">\n                        <label data-kid=\"1-2-1-2-3-1-1\">\n                            01 · Choose a service\n                        </label>\n                        <select class=\"rr-select\" data-kid=\"1-2-1-2-3-1-2\">\n                            <option data-kid=\"1-2-1-2-3-1-2-1\">\n                                Car Upholstery · from KES 18,000\n                            </option>\n                            <option data-kid=\"1-2-1-2-3-1-2-2\">\n                                Custom Car Seats · from KES 14,500\n                            </option>\n                            <option data-kid=\"1-2-1-2-3-1-2-3\">\n                                Leather Work & Stitching · from KES 22,000\n                            </option>\n                        </select>\n                    </div>\n                    <div class=\"rr-field\" data-kid=\"1-2-1-2-3-2\">\n                        <label data-kid=\"1-2-1-2-3-2-1\">\n                            02 · Vehicle type\n                        </label>\n                        <div class=\"rr-vehicle\" data-kid=\"1-2-1-2-3-2-2\">\n                            <button class=\"rr-chip active\" data-kid=\"1-2-1-2-3-2-2-1\" type=\"button\">\n                                Car\n                            </button>\n                            <button class=\"rr-chip\" data-kid=\"1-2-1-2-3-2-2-2\" type=\"button\">\n                                SUV\n                            </button>\n                            <button class=\"rr-chip\" data-kid=\"1-2-1-2-3-2-2-3\" type=\"button\">\n                                Van\n                            </button>\n                            <button class=\"rr-chip\" data-kid=\"1-2-1-2-3-2-2-4\" type=\"button\">\n                                Truck\n                            </button>\n                            <button class=\"rr-chip\" data-kid=\"1-2-1-2-3-2-2-5\" type=\"button\">\n                                Matatu\n                            </button>\n                            <button class=\"rr-chip\" data-kid=\"1-2-1-2-3-2-2-6\" type=\"button\">\n                                Other\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"rr-field rr-two\" data-kid=\"1-2-1-2-3-3\">\n                        <div data-kid=\"1-2-1-2-3-3-1\">\n                            <label data-kid=\"1-2-1-2-3-3-1-1\">\n                                03 · Preferred date\n                            </label>\n                            <input class=\"rr-input\" data-dynamic=\"true\" data-kid=\"1-2-1-2-3-3-1-2\" data-name=\"preferred date input field\" data-reason=\"value initialized to current date by script\" type=\"text\" value=\"12 Sep 2026\"/>\n                        </div>\n                        <div data-kid=\"1-2-1-2-3-3-2\">\n                            <label data-kid=\"1-2-1-2-3-3-2-1\">\n                                Preferred time\n                            </label>\n                            <select class=\"rr-select\" data-kid=\"1-2-1-2-3-3-2-2\">\n                                <option data-kid=\"1-2-1-2-3-3-2-2-1\">\n                                    10:00 AM – 12:00 PM\n                                </option>\n                            </select>\n                        </div>\n                    </div>\n                    <div class=\"rr-field\" data-kid=\"1-2-1-2-3-4\">\n                        <label data-kid=\"1-2-1-2-3-4-1\">\n                            04 · Fitting location\n                        </label>\n                        <div class=\"rr-location\" data-kid=\"1-2-1-2-3-4-2\">\n                            <button class=\"active\" data-kid=\"1-2-1-2-3-4-2-1\" type=\"button\">\n                                Rolling Razors workshop\n                                <small data-kid=\"1-2-1-2-3-4-2-1-1\">\n                                    Industrial Area, Nairobi\n                                </small>\n                            </button>\n                            <button data-kid=\"1-2-1-2-3-4-2-2\" type=\"button\">\n                                Customer location\n                                <small data-kid=\"1-2-1-2-3-4-2-2-1\">\n                                    On-site / mobile fit\n                                </small>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"rr-estimate\" data-kid=\"1-2-1-2-3-5\">\n                        <span data-kid=\"1-2-1-2-3-5-1\">\n                            Starting estimate\n                        </span>\n                        <strong data-kid=\"1-2-1-2-3-5-2\">\n                            KES 18,000\n                        </strong>\n                    </div>\n                    <button class=\"rr-btn rr-btn-gold\" data-kid=\"1-2-1-2-3-6\" type=\"button\">\n                