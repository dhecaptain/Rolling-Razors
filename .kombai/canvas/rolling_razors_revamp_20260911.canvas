hoose one\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-2 mt-4\" data-kid=\"1-2-3-1-2-2-1-2\">\n                                <button class=\"rr-material is-active min-h-[64px] border border-[#D6A62E] text-left px-3\" data-kid=\"1-2-3-1-2-2-1-2-1\" data-spec=\"Nappa leather\" data-spec-image=\"/api/local/images/public/images/upholstery/upholstery-02.jpg\">\n                                    <span class=\"block text-[12px] font-bold\" data-kid=\"1-2-3-1-2-2-1-2-1-1\">\n                                        Genuine Nappa Leather\n                                    </span>\n                                    <span class=\"block text-[10px] text-[#F5F1E8]/52 mt-1\" data-kid=\"1-2-3-1-2-2-1-2-1-2\">\n                                        Silky smooth / durable\n                                    </span>\n                                </button>\n                                <button class=\"rr-material min-h-[64px] border border-[#F5F1E8]/18 text-left px-3\" data-kid=\"1-2-3-1-2-2-1-2-2\" data-spec=\"Italian full grain\" data-spec-image=\"/api/local/images/public/images/upholstery/upholstery-10.jpg\">\n                                    <span class=\"block text-[12px] font-bold\" data-kid=\"1-2-3-1-2-2-1-2-2-1\">\n                                        Italian Full Grain\n                                    </span>\n                                    <span class=\"block text-[10px] text-[#F5F1E8]/52 mt-1\" data-kid=\"1-2-3-1-2-2-1-2-2-2\">\n                                        Natural cowhide\n                                    </span>\n                                </button>\n                                <button class=\"rr-material min-h-[64px] border border-[#F5F1E8]/18 text-left px-3\" data-kid=\"1-2-3-1-2-2-1-2-3\" data-spec=\"Commercial vinyl\" data-spec-image=\"/api/local/images/public/images/cushioning/cushioning-01.jpeg\">\n                     